{% doc %}
  @prompt
    make me a contact section that just take the email of client and submit it
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-email-contact-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-email-contact__content-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-email-contact__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.spacing }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-email-contact__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.spacing }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-email-contact__form-wrapper-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-email-contact__form-field-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.field_gap }}px;
    flex-direction: {{ block.settings.layout }};
  }

  .ai-email-contact__input-{{ ai_gen_id }} {
    flex: 1;
    padding: {{ block.settings.input_padding }}px;
    font-size: {{ block.settings.input_font_size }}px;
    border: {{ block.settings.input_border_width }}px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    background-color: {{ block.settings.input_background }};
    color: {{ block.settings.input_text_color }};
  }

  .ai-email-contact__input-{{ ai_gen_id }}::placeholder {
    color: {{ block.settings.placeholder_color }};
  }

  .ai-email-contact__button-{{ ai_gen_id }} {
    padding: {{ block.settings.button_padding }}px {{ block.settings.button_padding | times: 1.5 }}px;
    font-size: {{ block.settings.button_font_size }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    cursor: pointer;
    transition: background-color 0.3s ease;
    white-space: nowrap;
  }

  .ai-email-contact__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  .ai-email-contact__message-{{ ai_gen_id }} {
    margin-top: {{ block.settings.spacing }}px;
    padding: 12px;
    border-radius: {{ block.settings.input_border_radius }}px;
    font-size: {{ block.settings.description_size }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-email-contact__success-{{ ai_gen_id }} {
    background-color: {{ block.settings.success_background }};
    color: {{ block.settings.success_text_color }};
  }

  .ai-email-contact__error-{{ ai_gen_id }} {
    background-color: {{ block.settings.error_background }};
    color: {{ block.settings.error_text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-email-contact__form-field-{{ ai_gen_id }} {
      flex-direction: column;
    }
  }
{% endstyle %}

<email-contact-{{ ai_gen_id }}
  class="ai-email-contact-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {%- form 'contact' -%}
    <div class="ai-email-contact__content-{{ ai_gen_id }}">
      {%- if block.settings.heading != blank -%}
        <h2 class="ai-email-contact__heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </h2>
      {%- endif -%}

      {%- if block.settings.description != blank -%}
        <div class="ai-email-contact__description-{{ ai_gen_id }}">
          {{ block.settings.description }}
        </div>
      {%- endif -%}

      <div class="ai-email-contact__form-wrapper-{{ ai_gen_id }}">
        <div class="ai-email-contact__form-field-{{ ai_gen_id }}">
          <input
            type="email"
            name="contact[email]"
            class="ai-email-contact__input-{{ ai_gen_id }}"
            value="{{ form.email }}"
            placeholder="{{ block.settings.placeholder }}"
            aria-required="true"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            {% if form.errors %}
              aria-invalid="true"
              aria-describedby="ai-email-contact-error-{{ ai_gen_id }}"
            {% endif %}
            {% if form.posted_successfully? %}
              aria-describedby="ai-email-contact-success-{{ ai_gen_id }}"
            {% endif %}
            required
          >
          <button
            type="submit"
            class="ai-email-contact__button-{{ ai_gen_id }}"
          >
            {{ block.settings.button_text }}
          </button>
        </div>

        {%- if form.posted_successfully? -%}
          <div
            id="ai-email-contact-success-{{ ai_gen_id }}"
            class="ai-email-contact__message-{{ ai_gen_id }} ai-email-contact__success-{{ ai_gen_id }}"
          >
            {{ block.settings.success_message }}
          </div>
        {%- endif -%}

        {%- if form.errors -%}
          <div
            id="ai-email-contact-error-{{ ai_gen_id }}"
            class="ai-email-contact__message-{{ ai_gen_id }} ai-email-contact__error-{{ ai_gen_id }}"
          >
            {{ form.errors.messages.email }}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endform -%}
</email-contact-{{ ai_gen_id }}>

<script>
  (function() {
    class EmailContact{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.form = this.querySelector('form');
        if (this.form) {
          this.form.addEventListener('submit', this.handleSubmit.bind(this));
        }
      }

      handleSubmit(event) {
        const emailInput = this.querySelector('.ai-email-contact__input-{{ ai_gen_id }}');
        if (emailInput && !emailInput.value.trim()) {
          event.preventDefault();
        }
      }
    }

    customElements.define('email-contact-{{ ai_gen_id }}', EmailContact{{ ai_gen_id }});
  })();
</script>

