{% assign use_masonry = false %}
{% assign link_to = link_to | default: nil %}

{% assign images_layout_desktop = images_layout_desktop | default: images_layout | default: 'slideshow' %}
{% assign images_layout_mobile = images_layout_mobile | default: images_layout | default: 'slideshow' %}

<script>
  window.productLayout = window.innerWidth <= 749
    ? "{{ images_layout_mobile }}"
    : "{{ images_layout_desktop }}";
</script>

<script type="application/json" data-images>
  {% assign product_images = product.media | where: 'media_type', 'image'  %}

  {
    {%- for media in product_images %}
      {% if media.media_type == 'image' %}
        {%- capture rimg_string -%}
          {%
            render 'rimg',
            img: media,
            attr: 'data-product-main-image',
            size: '1400x',
            lazy: false
          %}
        {%- endcapture -%}
        "{{ media.id }}": {{ rimg_string | strip_newlines | json }}{%- unless forloop.last %},{%- endunless -%}
      {% endif %}
    {%- endfor -%}
  }
</script>

{% assign product_id = product.id %}
{% assign selected_variant = product.selected_or_first_available_variant %}

{% assign selected_media = selected_variant.featured_media | default: product.featured_media %}

<div
  class="product"
  data-ajax
  data-images-layout="{{ images_layout_desktop }}"
  data-images-layout-mobile="{{ images_layout_mobile }}"
>
  <div id="ProductGalleryWrapper">
    {%
      render 'product-gallery',
      images_layout: images_layout_desktop,
      use_masonry: use_masonry,
      product: product,
      selected_media: selected_media,
      enable_zoom: enable_zoom,
    %}
  </div>

  <div class="product-details-wrapper">
    <div class="product-details">
      {% if product != blank %}
        {% form 'product', product, data-product-form: '' %}
          {%
            render 'product-form-content',
            product: product,
            form: form,
            show_social_media_icons: show_social_media_icons,
            show_payment_button: show_payment_button,
          %}
        {% endform %}
      {% endif %}
    </div>
  </div>
</div>

<script>
  (function () {
    function forceCorrectLayout() {
      var wrapper = document.getElementById('ProductGalleryWrapper');
      if (!wrapper) return;

      var isMobile = window.innerWidth <= 749;
      var layout = isMobile
        ? wrapper.closest('.product').dataset.imagesLayoutMobile
        : wrapper.closest('.product').dataset.imagesLayout;

      // destroy existing gallery content
      wrapper.innerHTML = '';

      // reload correct gallery via AJAX-like render trick
      fetch(window.location.href)
        .then(res => res.text())
        .then(html => {
          var div = document.createElement('div');
          div.innerHTML = html;

          var newGallery = div.querySelector('#ProductGalleryWrapper');
          if (newGallery) {
            wrapper.innerHTML = newGallery.innerHTML;
          }
        });
    }

    document.addEventListener('DOMContentLoaded', function () {
      if (window.innerWidth <= 749) {
        forceCorrectLayout();
      }
    });
  })();
</script>
