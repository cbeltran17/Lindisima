{% assign use_masonry = false %}
{% assign link_to = link_to | default: nil %}
{% assign images_layout_desktop = images_layout_desktop | default: images_layout | default: 'slideshow' %}
{% assign images_layout_mobile = images_layout_mobile | default: images_layout | default: 'slideshow' %}

<script type="application/json" data-images>
  {% assign product_images = product.media | where: 'media_type', 'image'  %}

  {
    {%- for media in product_images %}
      {% if media.media_type == 'image' %}
        {%- capture rimg_string -%}
          {%
            render 'rimg',
            img: media,
            attr: 'data-product-main-image',
            size: '1400x',
            lazy: false
          %}
        {%- endcapture -%}
        "{{ media.id }}": {{ rimg_string | strip_newlines | json }}{%- unless forloop.last %},{%- endunless -%}
      {% endif %}
    {%- endfor -%}
  }
</script>

{% assign product_id = product.id %}
{% assign selected_variant = product.selected_or_first_available_variant %}

{% if collection == null or collection.handle == 'frontpage' or collection.handle == 'all' %}
  {% assign found_a_collection = false %}
  {% for c in product.collections %}
    {% if found_a_collection == false and c.handle != 'frontpage' and c.handle != 'all' %}
      {% assign found_a_collection = true %}
      {% assign collection = c %}
    {% endif %}
  {% endfor %}
{% endif %}

{% assign selected_media = selected_variant.featured_media | default: product.featured_media %}

<div
  class="
    product
    {% if images_layout_desktop == 'masonry' or images_layout_mobile == 'masonry' %}
      product-masonry
    {% endif %}
  "
  data-ajax
  data-images-layout-desktop="{{ images_layout_desktop }}"
  data-images-layout-mobile="{{ images_layout_mobile }}"

  {% if enable_zoom %}
    data-zoom
  {% endif %}

  {% if enable_linked_options %}
    data-linked-options
  {% endif %}
>
  <div class="product-gallery-shell">
    <div class="product-gallery-wrapper product-gallery-wrapper--desktop">
      {%
        render 'product-gallery',
        images_layout: images_layout_desktop,
        use_masonry: use_masonry,
        product: product,
        selected_media: selected_media,
        enable_zoom: enable_zoom,
      %}
    </div>

    <div class="product-gallery-wrapper product-gallery-wrapper--mobile">
      {%
        render 'product-gallery',
        images_layout: images_layout_mobile,
        use_masonry: use_masonry,
        product: product,
        selected_media: selected_media,
        enable_zoom: enable_zoom,
      %}
    </div>
  </div>

  <div class="product-details-wrapper">
    <div class="product-details">
      {% if product != blank %}
        {% form 'product', product, data-product-form: '' %}
          {%
            render 'product-form-content',
            product: product,
            form: form,
            show_social_media_icons: show_social_media_icons,
            show_payment_button: show_payment_button,
          %}
        {% endform %}
      {% else %}
        <div data-product-form>
          {%
            render 'product-form-content',
            product: nil,
            form: nil,
            show_social_media_icons: show_social_media_icons,
            show_payment_button: show_payment_button,
          %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

<style>
  .product-gallery-shell {
    position: relative;
  }

  .product-gallery-wrapper {
    width: 100%;
  }

  .product-gallery-wrapper--mobile {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    z-index: 1;
  }

  .product-gallery-wrapper--desktop {
    position: relative;
    opacity: 1;
    pointer-events: auto;
    z-index: 2;
  }

  .product-gallery-shell.is-mobile .product-gallery-wrapper--desktop {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    z-index: 1;
  }

  .product-gallery-shell.is-mobile .product-gallery-wrapper--mobile {
    position: relative;
    opacity: 1;
    pointer-events: auto;
    z-index: 2;
  }

  .product-gallery-shell.is-desktop .product-gallery-wrapper--desktop {
    position: relative;
    opacity: 1;
    pointer-events: auto;
    z-index: 2;
  }

  .product-gallery-shell.is-desktop .product-gallery-wrapper--mobile {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    z-index: 1;
  }

  .product-gallery-wrapper .flickity-page-dots .dot,
  .product-gallery-wrapper .swiper-pagination-bullet,
  .product-gallery-wrapper .splide__pagination__page,
  .product-gallery-wrapper [class*="page-dot"],
  .product-gallery-wrapper [class*="pagination-bullet"] {
    border-radius: 999px !important;
    width: 8px !important;
    height: 8px !important;
    min-width: 8px !important;
    min-height: 8px !important;
    margin: 0 4px !important;
  }

  .product-gallery-wrapper .flickity-page-dots,
  .product-gallery-wrapper .swiper-pagination,
  .product-gallery-wrapper .splide__pagination {
    align-items: center !important;
  }
</style>

<script>
  (function () {
    function setGalleryMode() {
      var shell = document.querySelector('.product-gallery-shell');
      if (!shell) return;

      var isMobile = window.matchMedia('(max-width: 749px)').matches;
      shell.classList.toggle('is-mobile', isMobile);
      shell.classList.toggle('is-desktop', !isMobile);
    }

    document.addEventListener('DOMContentLoaded', function () {
      setGalleryMode();
      window.addEventListener('resize', setGalleryMode);
    });
  })();
</script>
