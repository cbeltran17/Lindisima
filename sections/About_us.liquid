{% comment %} 
  Dynamic About Us Section with Block-based Content & Independent Alignment
{% endcomment %}

<style>
  .about-custom-{{ section.id }} {
    padding: 60px 20px;
    background-color: {{ section.settings.bg_color_desktop }};
  }

  .about-container-{{ section.id }} {
    max-width: 1820px;
    width: 100%;
    margin: 0 auto;
  }

  /* Block-Specific Alignment Logic */
  {% for block in section.blocks %}
    .block-{{ block.id }} {
      text-align: {{ block.settings.align_desktop }};
    }
    
    @media (max-width: 767px) {
      .block-{{ block.id }} {
        text-align: {{ block.settings.align_mobile }};
      }
    }
  {% endfor %}

  /* Title Block */
  .about-title {
    font-family: 'Roboto', sans-serif;
    font-weight: 700;
    font-size: 34px;
    margin-bottom: 25px;
    color: {{ section.settings.text_color_desktop }};
  }

  /* Description Block */
  .about-desc {
    font-size: 16px;
    line-height: 1.6;
    max-width: 1120px;
    display: inline-block;
    width: 100%;
    color: {{ section.settings.text_color_desktop }};
  }

  /* Button Block */
  .about-btn-wrapper {
    margin-top: 30px;
  }
  .about-btn {
    display: inline-block;
    padding: 12px 45px;
    border: 1px solid {{ section.settings.text_color_desktop }};
    border-radius: 50px;
    text-decoration: none;
    font-weight: 500;
    color: {{ section.settings.text_color_desktop }};
    background: transparent;
    transition: all 0.3s ease;
  }

  /* Mobile Overrides */
  @media (max-width: 767px) {
    .about-custom-{{ section.id }} {
      background-color: {{ section.settings.bg_color_mobile }};
              padding: 33px 15px 45px;
    }
    .about-title {
      font-size: 28px;
      color: {{ section.settings.text_color_mobile }};
    }
    .about-desc {
      font-size: 14px;
      color: {{ section.settings.text_color_mobile }};
    }
    .about-btn {
      color: {{ section.settings.text_color_mobile }};
      border-color: {{ section.settings.text_color_mobile }};
    }
  }
  .about-desc p{
    margin: 0 !important;
  }
</style>

<div class="about-custom-{{ section.id }}">
  <div class="about-container-{{ section.id }}">
    {% for block in section.blocks %}
      <div class="about-block-item block-{{ block.id }}" {{ block.shopify_attributes }}>
        {% case block.type %}
          
          {% when 'title' %}
            <h2 class="about-title">{{ block.settings.title_text }}</h2>

          {% when 'description' %}
            <div class="about-desc">{{ block.settings.content }}</div>
          {% when 'button' %}
            <div class="about-btn-wrapper">
              <a href="{{ block.settings.link }}" class="about-btn">
                {{ block.settings.btn_label }}
              </a>
            </div>

        {% endcase %}
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "About Us",
  "settings": [
    {
      "type": "header",
      "content": "Desktop Settings"
    },
    {
      "type": "color",
      "id": "bg_color_desktop",
      "label": "Desktop Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color_desktop",
      "label": "Desktop Text Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Mobile Settings"
    },
    {
      "type": "color",
      "id": "bg_color_mobile",
      "label": "Mobile Background",
      "default": "#8F9C87"
    },
    {
      "type": "color",
      "id": "text_color_mobile",
      "label": "Mobile Text Color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "title",
      "name": "Title",
      "settings": [
        {
          "type": "text",
          "id": "title_text",
          "label": "Title",
          "default": "About Us"
        },
        {
          "type": "select",
          "id": "align_desktop",
          "label": "Desktop Alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "center"
        },
        {
          "type": "select",
          "id": "align_mobile",
          "label": "Mobile Alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "center"
        }
      ]
    },
    {
      "type": "description",
      "name": "Description",
      "settings": [
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Lorem ipsum dolor sit amet...</p>"
        },
        {
          "type": "select",
          "id": "align_desktop",
          "label": "Desktop Alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "center"
        },
        {
          "type": "select",
          "id": "align_mobile",
          "label": "Mobile Alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "center"
        }
      ]
    },
    {
      "type": "button",
      "name": "CTA Button",
      "settings": [
        {
          "type": "text",
          "id": "btn_label",
          "label": "Button Label",
          "default": "Read More"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "align_desktop",
          "label": "Desktop Alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "center"
        },
        {
          "type": "select",
          "id": "align_mobile",
          "label": "Mobile Alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "center"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Us",
      "blocks": [
        { "type": "title" },
        { "type": "description" },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}