<style>
  .skin-goals-section {
    max-width: 1820px;
    margin: 0 auto;
    padding: 40px 10px;
    overflow: hidden;
  }

  .skin-goals-header {
    /* margin-bottom: 30px; */
    text-align: {{ section.settings.header_alignment }};
  }

  .skin-goals-title {
    font-family: 'Roboto', sans-serif;
    font-weight: 700;
    font-size: 34px;
    line-height: 100%;
    letter-spacing: 0.03em;
    margin: 0 0 19px 0;
    color: #000;
  }

  .skin-goals-description {
    font-family: 'Roboto', sans-serif;
    font-size: 16px;
    color: #666;
  }

  /* Grid / Slider Layout */
  .skin-goals-grid {
    margin: 0 -15.75px; /* Half of 31.5px gap */
  }

  .skin-goal-card {
    padding: 0 15.75px;
    outline: none;
  }

  /* Make the whole card link fill the card */
  .card-link {
    display: block;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  .card-inner {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    aspect-ratio: 1 / 1.2; /* Adjust based on your image preference */
    background-size: cover;
    background-position: center;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 23px 35px;
    height: 100%;
  }

  .card-title {
    color: rgba(143, 156, 135, 1);
    font-family: 'ClimateCrisis';
    font-weight: 400;
    font-size: 44px;
    line-height: 100%;
    letter-spacing: 0.03em;
    margin: 0;
    text-transform: capitalize;
  }

  .card-button-wrapper {
    width: 100%;
    display: flex;
    justify-content: center;
    padding-bottom: 10px;
  }

  /* Styled button (now a span inside the link to avoid nested anchors) */
  .card-btn {
    display: inline-block;
    padding: 10px 35px;
    border: 1px solid transparent;
    border-radius: 50px;
    background: #E2CFCE; /* pink default */
    color: #fff; /* white text by default */
    text-decoration: none;
    font-family: 'Roboto', sans-serif;
    font-weight: 500;
    font-size: 14px;
    transition: all 0.25s ease;
    cursor: pointer;
  }

  /* Hover: when hovering button itself OR hovering the whole card */
  .card-btn:hover,
  .card-link:hover .card-btn {
    background: #000;
    color: #fff;
    border-color: #000;
  }

  /* Disabled / non-link button style */
  .card-btn.disabled {
    opacity: 0.6;
    cursor: default;
    pointer-events: none;
  }

  /* Mobile Styles */
  @media (max-width: 767px) {
    .skin-goals-section{
      padding: 0 17px;
    }
    .skin-goals-title {
      font-size: 26px;
      font-weight: 600;
    }

    .skin-goals-grid {
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 20px; /* Add some space between cards */
    }

    .skin-goal-card {
      padding: 0;
      width: 100%;
    }

    .card-title {
      font-size: 28px; /* Downsized for mobile readability */
    }

    .card-inner {
      aspect-ratio: 1 / 1.2;
      padding: 14px 21px;
    }
  }
</style>

<div class="skin-goals-section">
  <div class="skin-goals-header">
    {% if section.settings.title != blank %}
      <h2 class="skin-goals-title">{{ section.settings.title }}</h2>
    {% endif %}
    {% if section.settings.description != blank %}
      <div class="skin-goals-description">{{ section.settings.description }}</div>
    {% endif %}
  </div>

  <div class="skin-goals-grid" id="SkinGoalsSlider-{{ section.id }}">
    {% for block in section.blocks %}
      <div class="skin-goal-card" {{ block.shopify_attributes }}>
        {% comment %}
          If a link is provided, wrap the entire card in an anchor so the image is clickable.
          The visible button is a <span> inside the link (so we avoid nested anchors).
        {% endcomment %}
        {% if block.settings.link != blank %}
          <a href="{{ block.settings.link }}" class="card-link" title="{{ block.settings.title }}">
            <div class="card-inner" style="background-image: url('{{ block.settings.image | img_url: '800x' }}');">
              <h3 class="card-title">{{ block.settings.title }}</h3>
              {% if block.settings.button_text != blank %}
                <div class="card-button-wrapper">
                  <span class="card-btn" role="button" tabindex="0">{{ block.settings.button_text }}</span>
                </div>
              {% endif %}
            </div>
          </a>
        {% else %}
          <div class="card-inner" style="background-image: url('{{ block.settings.image | img_url: '800x' }}');">
            <h3 class="card-title">{{ block.settings.title }}</h3>
            {% if block.settings.button_text != blank %}
              <div class="card-button-wrapper">
                <!-- No link provided: show a disabled-looking button (non-clickable) -->
                <span class="card-btn disabled" aria-disabled="true">{{ block.settings.button_text }}</span>
              </div>
            {% endif %}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

<script>
  // Slick init (unchanged behavior except breakpoint matches CSS)
  $(document).ready(function(){
    $('#SkinGoalsSlider-{{ section.id }}').slick({
      infinite: false,
      slidesToShow: 3,
      slidesToScroll: 1,
      arrows: false,
      dots: false,
      responsive: [
        {
          breakpoint: 1024,
          settings: {
            slidesToShow: 2.2,
            infinite: false
          }
        },
        {
          breakpoint: 767, /* Change breakpoint to 767px to match CSS media query */
          settings: "unslick" /* Unslick the slider on mobile */
        }
      ]
    });

    // Keyboard accessibility:
    // If user focuses the .card-btn (span) and presses Enter or Space, navigate to the parent link href.
    $('#SkinGoalsSlider-{{ section.id }}').on('keydown', '.card-btn', function(e){
      var key = e.key || e.keyCode;
      if (key === 'Enter' || key === ' ' || key === 13 || key === 32) {
        // find parent anchor (card-link) if exists
        var $btn = $(this);
        var $parentLink = $btn.closest('.card-link');
        if ($parentLink.length) {
          window.location = $parentLink.attr('href');
        }
      }
    });
  });
</script>

{% schema %}
{
  "name": "Product Image Card",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Shop by Skin Goals"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Section Description"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    }
  ],
  "blocks": [
    {
      "type": "goal_block",
      "name": "Skin Goal",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Goal Title",
          "default": "Hydration"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Image Card",
      "blocks": [
        { "type": "goal_block" },
        { "type": "goal_block" },
        { "type": "goal_block" }
      ]
    }
  ]
}
{% endschema %}
