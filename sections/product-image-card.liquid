<style>
  .skin-goals-section {
    max-width: 1820px;
    margin: 0 auto;
    padding: 40px 10px;
    overflow: hidden;
  }

  .skin-goals-header {
    text-align: {{ section.settings.header_alignment }};
  }

  .skin-goals-title {
    font-family: 'Roboto', sans-serif;
    font-weight: 700;
    font-size: 34px;
    line-height: 100%;
    letter-spacing: 0.03em;
    margin: 0 0 19px 0;
    color: #000;
  }

  .skin-goals-description {
    font-family: 'Roboto', sans-serif;
    font-size: 16px;
    color: #666;
  }

  /* Grid / Slider Layout */
  .skin-goals-grid {
    margin: 0 -15.75px; /* Half of 31.5px gap */
    display: flex;
    flex-wrap: nowrap;
    align-items: stretch;
  }

  .skin-goal-card {
    padding: 0 15.75px;
    outline: none;
    display: flex;
    flex-direction: column; /* stack image then button */
    align-items: stretch;
  }

  /* Make the whole image area a link if provided */
  .card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .card-inner {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    aspect-ratio: 1 / 1.2; /* Adjust based on your image preference */
    background-size: cover;
    background-position: center;
    display: flex;
    flex-direction: column;
    justify-content: flex-start; /* title appears toward top */
    padding: 23px 35px;
    height: 100%;
    box-sizing: border-box;
  }

  .card-title {
    color: rgba(143, 156, 135, 1);
    font-family: 'ClimateCrisis';
    font-weight: 400;
    font-size: 44px;
    line-height: 100%;
    letter-spacing: 0.03em;
    margin: 0;
    text-transform: capitalize;
  }

  /* Button wrapper placed under the image */
  .card-button-wrapper {
    width: 100%;
    display: flex;
    justify-content: center;
    margin-top: 12px;
    padding-bottom: 10px;
  }

  .card-btn {
    display: inline-block;
    padding: 10px 35px;
    border: 1px solid transparent;
    border-radius: 50px;
    background: #E2CFCE; /* pink default */
    color: #fff; /* white text by default */
    text-decoration: none;
    font-family: 'Roboto', sans-serif;
    font-weight: 500;
    font-size: 14px;
    transition: all 0.25s ease;
    cursor: pointer;
  }

  /* Hover: button itself turns black with white text */
  .card-btn:hover {
    background: #000;
    color: #fff;
    border-color: #000;
  }

  /* Disabled / non-link button style */
  .card-btn.disabled {
    opacity: 0.6;
    cursor: default;
    pointer-events: none;
  }

  /* Mobile Styles */
  @media (max-width: 767px) {
    .skin-goals-section {
      padding: 0 17px;
    }
    .skin-goals-title {
      font-size: 26px;
      font-weight: 600;
    }

    .skin-goals-grid {
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 20px; /* Add some space between cards */
    }

    .skin-goal-card {
      padding: 0;
      width: 100%;
    }

    .card-title {
      font-size: 28px; /* Downsized for mobile readability */
    }

    .card-inner {
      aspect-ratio: 1 / 1.2;
      padding: 14px 21px;
    }
  }
</style>

<div class="skin-goals-section">
  <div class="skin-goals-header">
    {% if section.settings.title != blank %}
      <h2 class="skin-goals-title">{{ section.settings.title }}</h2>
    {% endif %}
    {% if section.settings.description != blank %}
      <div class="skin-goals-description">{{ section.settings.description }}</div>
    {% endif %}
  </div>

  <div class="skin-goals-grid" id="SkinGoalsSlider-{{ section.id }}">
    {% for block in section.blocks %}
      <div class="skin-goal-card" {{ block.shopify_attributes }}>
        {% comment %}
          Image area: clickable if link exists. Button placed under the image (outside of the image/link).
        {% endcomment %}

        {% if block.settings.link != blank %}
          <a href="{{ block.settings.link }}" class="card-link" title="{{ block.settings.title }}">
            <div class="card-inner" style="background-image: url('{{ block.settings.image | img_url: '800x' }}');">
              <h3 class="card-title">{{ block.settings.title }}</h3>
            </div>
          </a>
        {% else %}
          <div class="card-inner" style="background-image: url('{{ block.settings.image | img_url: '800x' }}');">
            <h3 class="card-title">{{ block.settings.title }}</h3>
          </div>
        {% endif %}

        {% if block.settings.button_text != blank %}
          <div class="card-button-wrapper">
            {% if block.settings.link != blank %}
              <!-- Button is a separate anchor under the image -->
              <a href="{{ block.settings.link }}" class="card-btn">{{ block.settings.button_text }}</a>
            {% else %}
              <span class="card-btn disabled" aria-disabled="true">{{ block.settings.button_text }}</span>
            {% endif %}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

<script>
  $(document).ready(function(){
    $('#SkinGoalsSlider-{{ section.id }}').slick({
      infinite: false,
      slidesToShow: 3,
      slidesToScroll: 1,
      arrows: false,
      dots: false,
      responsive: [
        {
          breakpoint: 1024,
          settings: {
            slidesToShow: 2.2,
            infinite: false
          }
        },
        {
          breakpoint: 767,
          settings: "unslick" /* Unslick the slider on mobile */
        }
      ]
    });
  });
</script>

{% schema %}
{
  "name": "Product Image Card",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Shop by Skin Goals"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Section Description"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    }
  ],
  "blocks": [
    {
      "type": "goal_block",
      "name": "Skin Goal",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Goal Title",
          "default": "Hydration"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Image Card",
      "blocks": [
        { "type": "goal_block" },
        { "type": "goal_block" },
        { "type": "goal_block" }
      ]
    }
  ]
}
{% endschema %}
