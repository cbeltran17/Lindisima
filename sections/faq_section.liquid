{% comment %} 
  Split FAQ Section - Centered Layout for Desktop
{% endcomment %}

<style>
  .faq-section-{{ section.id }} {
    max-width: 1820px;
    padding: 60px 20px;
    margin: auto;
  }

  .faq-container {
    display: flex;
    flex-direction: column;
    gap: 50px;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
  }

  .faq-info {
    width: 100%;
    max-width: 700px;
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .faq-header-title {
    margin: 0 0 16px 0;
    font-weight: 700;
    font-size: 34px;
    line-height: 100%;
    letter-spacing: 3%;
    color: white;
  }

  .faq-header-desc {
    font-size: 16px;
    line-height: 1.6;
    color: white;
  }

  .faq-accordion {
    width: 100%;
    max-width: 700px;
  }

  .faq-item {
    border-bottom: 1px solid #e0e0e0;
  }

  .faq-trigger {
    width: 100%;
    padding: 11px 0 14px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 16px;
    text-align: left;
  }

  .faq-question {
    margin: 0;
    font-weight: 400;
    font-size: 16px;
    line-height: 24px;
    letter-spacing: 0%;
    color: white;
  }

  .faq-icon {
    font-size: 28px;
    font-weight: 300;
    line-height: 1;
    display: inline-block;
    transition: transform 0.3s ease;
    color: white;
    width: 20px;
    text-align: center;
    flex-shrink: 0;
    margin-left: 15px;
  }

  .faq-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease-out;
  }

  .faq-inner-desc {
    padding-bottom: 25px;
    font-size: 15px;
    line-height: 1.6;
    color: white;
  }

  .faq-inner-desc p {
    margin: 0;
  }

  .faq-item.is-active .faq-content {
    max-height: 1000px;
  }

  .view-more-button {
    background-color: transparent;
    color: white;
    padding: 10px 20px;
    border: 1px solid white;
    border-radius: 12px;
    cursor: pointer;
    margin: 20px auto;
    display: block;
    font-size: 16px;
    text-decoration: none;
    text-align: center;
    width: fit-content;
  }

  @media (max-width: 1024px) {
    .faq-container {
      flex-direction: column;
      gap: 30px;
    }
    .faq-info {
      width: 100%;
      max-width: 600px;
    }
    .faq-accordion {
      width: 100%;
      max-width: 600px;
    }
  }

  @media (max-width: 767px) {
    .faq-section-{{ section.id }} {
      margin-bottom: 34px;
      margin-top: 0;
    }
    .faq-header-title {
      font-size: 28px;
    }
    .faq-header-desc {
      font-weight: 400;
    }
    .faq-trigger {
      padding: 11px 0 10px 0;
    }
    .faq-info {
      max-width: 100%;
    }
    .faq-accordion {
      max-width: 100%;
    }
  }
</style>

<div class="faq-section-{{ section.id }}">
  <div class="faq-container">
    
    <div class="faq-info">
      <h2 class="faq-header-title">{{ section.settings.title }}</h2>
      <div class="faq-header-desc">{{ section.settings.description }}</div>
    </div>

    <div class="faq-accordion">
      {% assign faq_count = 0 %}
      {% for block in section.blocks %}
        {% assign faq_count = faq_count | plus: 1 %}
        {% if faq_count <= 5 %}
          <div class="faq-item" {{ block.shopify_attributes }}>
            <button class="faq-trigger" onclick="toggleFaq(this)">
              <h3 class="faq-question">{{ block.settings.question }}</h3>
              <span class="faq-icon" id="icon-{{ block.id }}">+</span>
            </button>
            <div class="faq-content">
              <div class="faq-inner-desc">
                {{ block.settings.answer }}
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}

      {% if section.blocks.size > 5 %}
        <a href="https://lindisimany.com/pages/faq" class="view-more-button" id="view-more-button-{{ section.id }}">
          View More
        </a>
      {% endif %}
    </div>

  </div>
</div>

<script>
  function toggleFaq(element ) {
    const parent = element.parentElement;
    const icon = element.querySelector(".faq-icon");
    const isActive = parent.classList.contains("is-active");
    
    document.querySelectorAll(".faq-item").forEach(item => {
      if (item !== parent) {
        item.classList.remove("is-active");
        item.querySelector(".faq-icon").textContent = "+";
      }
    });

    if (!isActive) {
      parent.classList.add("is-active");
      icon.textContent = "-";
    } else {
      parent.classList.remove("is-active");
      icon.textContent = "+";
    }
  }
</script>

{% schema %}
{
  "name": "FAQ Split Section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "FAQ's"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Section Description",
      "default": "Add your sidebar text here."
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question Title" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Detailed answer goes here.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Split Section"
    }
  ]
}
{% endschema %}
