<div class="faq-section-{{ section.id }} {{ section.settings.custom_class }}" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <h2 style="color: {{ section.settings.heading_color }}">{{ section.settings.faq_heading }}</h2>
  <div class="faq-items">
    {% for block in section.blocks %}
        {%- case block.type -%}
          {%- when 'faq_item' -%}
          <div class="faq-item">
            <button class="faq-question" style="color: {{ section.settings.question_color }}">
              {{ block.settings.question }}
              <span class="faq-toggle">+</span>
            </button>
            <div class="faq-answer" style="color: {{ section.settings.answer_color }}">
              {{ block.settings.answer | newline_to_br }}
            </div>
          </div>

        {% endcase %}
    {% endfor %}
  </div>
</div>
<style>
  .{{ section.settings.custom_class }} {
    max-width: 800px;
    margin: 0 auto;
  }

  .{{ section.settings.custom_class }} h2 {
    font-size: 28px;
    text-align: center;
        margin: 15px 0;
  }

  .{{ section.settings.custom_class }} .faq-item {
    border-bottom: 1px solid #e0e0e0;
  }

  .{{ section.settings.custom_class }} .faq-question {
    width: 100%;
    text-align: left;
    background: none;
    border: none;
    font-size: 18px;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 0;
  }

  .{{ section.settings.custom_class }} .faq-question:focus {
    outline: none;
  }

  .{{ section.settings.custom_class }} .faq-toggle {
    font-size: 24px;
    transition: all 0.3s;
  }

  .{{ section.settings.custom_class }} .faq-answer { 
  max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease, padding 0.4s ease;
    padding: 0;
  }

  .{{ section.settings.custom_class }} .faq-item.active .faq-answer {
    padding-top: 10px;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .{{ section.settings.custom_class }} h2 { font-size: 24px; }
    .{{ section.settings.custom_class }} .faq-question { font-size: 16px; }
    .{{ section.settings.custom_class }} .faq-answer { font-size: 15px; }
  }
  @media (max-width: 480px) {
    .{{ section.settings.custom_class }} {
      padding-left: 15px; 
      padding-right: 15px;
    }
    .{{ section.settings.custom_class }} .faq-question { font-size: 15px; }
    .{{ section.settings.custom_class }} .faq-answer { font-size: 14px; }
  }
</style>
