{% comment %} 
  Bestsellers / Featured Collection Section 
{% endcomment %}

<style>
  .bestseller-section {
    max-width: 1820px;
    margin: 0 auto;
    padding: 0 15px; 
    font-family: 'Roboto', sans-serif;
  }

  /* Header Styles */
  .bestseller-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 30px;
  }

  .bestseller-title {
    font-size: 34px;
    font-weight: 700;
    margin: 0;
    line-height: 1;
    letter-spacing: 0.03em;
  }

  .view-all-link {
    font-size: 16px;
    font-weight: 400;
    color: #000;
    text-decoration: underline;
    text-underline-offset: 4px; 
  }

  /* Grid Layout (Desktop & Tablet) */
  .product-grid {
    display: flex;
    flex-wrap: wrap;
    margin: 0 -15px;
  }

  .product-card {
    width: 25%;
    padding: 0 16px;
    margin-bottom: 30px;
    box-sizing: border-box;
  }

  .product-image-wrapper {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 12px;
    overflow: hidden;
    background-color: #f5f5f5;
    margin-bottom: 15px;
  }

  .product-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
    border-radius: 10px;
    display: block;
  }

  .product-card:hover img {
    transform: scale(1.05);
  }

  /* Out of Stock Label */
  .out-of-stock-label {
    position: absolute;
    top: 12px;
    left: 12px;
    background-color: #e02020;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: 6px;
    z-index: 10;
    line-height: 1;
    pointer-events: none;
  }

  .product-info {
    text-align: left;
    margin-top: 16px;
  }

  /* BADGES */
  .product-badges {
    margin-bottom: 12px;
  }

  .product-badges.is-single {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .product-badges.is-double {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .product-badges.is-multi {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .product-badges.is-double .product-badge {
    width: 100%;
  }

  .product-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #7f9474;
    color: #FFFFFF;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 8px 18px;
    border-radius: 6px;
    line-height: 1;
    white-space: nowrap;
    font-family: inherit;
    border: none;
    cursor: default;
    user-select: none;
    box-sizing: border-box;
    min-width: 0;
  }

  .product-name {
    font-size: 16px;
    font-weight: 700;
    margin: 0 0 5px 0;
    color: #000;
    text-decoration: none;
    display: block;
  }

  .product-price {
    font-size: 16px;
    font-weight: 400;
    color: #000;
  }

  .for-mobile-only { display: none; }

  /* Tablet Adjustments */
  @media (max-width: 1024px) and (min-width: 768px) {
    .product-card {
      width: 33.33%;
    }
  }

  /* Mobile Styles */
  @media (max-width: 767px) {
    .product-info {
      margin-top: 16px;
    }

    .for-mobile-only {
      display: block !important;
      text-align: center;
      font-weight: 400;
      font-size: 18px;
      line-height: 100%;
      letter-spacing: 3%;
      text-decoration: underline;
      text-decoration-style: solid;
      text-decoration-thickness: 0%;
      text-decoration-skip-ink: auto;
      margin-top: 18px;
    }

    .bestseller-section {
      padding: 0 17px;
      margin-bottom: 56px;
    }

    .bestseller-header {
      justify-content: flex-start;
    }

    .view-all-link {
      display: none;
    }

    .bestseller-title {
      font-size: 26px;
      font-weight: 600;
    }

    .product-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
      margin: 0;
    }

    .product-card {
      width: auto;
      padding: 0;
      margin-bottom: 0;
      box-sizing: border-box;
    }

    .product-image-wrapper {
      border-radius: 10px;
      margin-bottom: 10px;
    }

    .product-badges {
      margin-bottom: 10px;
    }

    .product-badges.is-single { gap: 8px; }
    .product-badges.is-double { gap: 8px; }
    .product-badges.is-multi  { gap: 8px; }

    .product-badge {
      font-size: 10px;
      padding: 7px 12px;
      letter-spacing: 0.10em;
    }

    /* Smaller label on mobile */
    .out-of-stock-label {
      font-size: 9px;
      padding: 5px 8px;
      top: 8px;
      left: 8px;
      border-radius: 4px;
    }

    .slick-list {
      padding: 0 !important;
      box-sizing: border-box;
    }
  }
</style>

<div class="bestseller-section" id="Bestseller-{{ section.id }}">
  {%- assign collection = collections[section.settings.collection] -%}
  {%- assign product_limit = 4 -%}

  <div class="bestseller-header">
    <h2 class="bestseller-title">{{ section.settings.title }}</h2>
    {% if collection.products_count > product_limit %}
      <a href="{{ collection.url }}" class="view-all-link">View All</a>
    {% endif %}
  </div>

  <div class="product-grid {% if collection.products_count > 0 %}js-bestseller-slider{% endif %}">
    {% for product in collection.products limit: product_limit %}
      <div class="product-card">

        <a href="{{ product.url }}" class="product-image-wrapper">
          {% unless product.available %}
            <span class="out-of-stock-label">Out of Stock</span>
          {% endunless %}
          <img
            src="{{ product.featured_image | img_url: '600x600', crop: 'center' }}"
            alt="{{ product.title | escape }}"
            loading="lazy">
        </a>

        <div class="product-info">
          {% if product.metafields.custom.badges != blank and product.metafields.custom.badges.value != blank %}
            {% assign badge_count = product.metafields.custom.badges.value.size %}
            <div class="product-badges {% if badge_count == 1 %}is-single{% elsif badge_count == 2 %}is-double{% else %}is-multi{% endif %}">
              {% for badge in product.metafields.custom.badges.value %}
                <span class="product-badge">{{ badge }}</span>
              {% endfor %}
            </div>
          {% endif %}

          <a href="{{ product.url }}" class="product-name">{{ product.title }}</a>
          <span class="product-price">{{ product.price | money }}</span>
        </div>

      </div>
    {% else %}
      {% for i in (1..4) %}
        <div class="product-card">
          <div class="product-image-wrapper">
            {{ 'product-' | append: i | placeholder_svg_tag }}
          </div>
          <div class="product-info">
            <p class="product-name">Product Name Here</p>
            <span class="product-price">$25.00</span>
          </div>
        </div>
      {% endfor %}
    {% endfor %}
  </div>

  {% if collection.products_count > product_limit %}
    <a href="{{ collection.url }}" class="view-all-link for-mobile-only">View All</a>
  {% endif %}
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    function ensureNoSlickOnMobileGrid() {
      const $slider = $('#Bestseller-{{ section.id }} .js-bestseller-slider');
      if ($slider.length && $slider.hasClass('slick-initialized')) {
        try {
          $slider.slick('unslick');
        } catch (e) {
          console.warn('slick unslick error', e);
        }
      }
    }
    ensureNoSlickOnMobileGrid();
    $(window).on('resize', ensureNoSlickOnMobileGrid);
  });
</script>

{% schema %}
{
  "name": "Bestsellers Collection",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Bestsellers"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    }
  ],
  "presets": [
    {
      "name": "Bestsellers Collection"
    }
  ]
}
{% endschema %}