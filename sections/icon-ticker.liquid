{% comment %}
  Refined Icon Ticker Section
{% endcomment %}

<style>
  .icon-ticker-wrapper-{{ section.id }} {
    background: {{ section.settings.bg_color }};
    padding: 15px 0;
    overflow: hidden;
    width: 100%;
    border-top: 1px solid #eaeaea;
    border-bottom: 1px solid #eaeaea;
  }

  .icon-ticker-{{ section.id }} {
    margin: 0 auto;
    display: flex;
    align-items: center;
  }

  .icon-ticker-item {
    display: flex !important;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 0 40px;
    outline: none;
  }

  .icon-ticker-item img {
    width: 24px;
    height: 24px;
    object-fit: contain;
    flex-shrink: 0;
    display: block;
  }

  .icon-ticker-text {
    font-family: inherit;
    font-weight: 400;
    font-size: 18px;
    color: {{ section.settings.text_color }};
    white-space: nowrap;
    text-transform: none;
    line-height: 100%;
    letter-spacing: 0.5px;
  }

  @media (max-width: 768px) {
    .icon-ticker-item {
      padding: 0 20px;
      gap: 8px;
    }

    .icon-ticker-text {
      font-size: 14px;
    }

    .icon-ticker-item img {
      width: 18px;
      height: 18px;
    }
  }

  .icon-ticker-{{ section.id }}:not(.slick-initialized) {
    display: flex;
    overflow: hidden;
    justify-content: center;
  }
</style>

{%- capture ticker_content -%}
  {% for block in section.blocks %}
    <div class="icon-ticker-item" {{ block.shopify_attributes }}>
      {% if block.settings.icon != blank %}
        <img src="{{ block.settings.icon | image_url: width: 50 }}" alt="" loading="lazy">
      {% endif %}
      <span class="icon-ticker-text">{{ block.settings.text }}</span>
    </div>
  {% endfor %}
{%- endcapture -%}

{% if template.name != 'product' or product.metafields.custom.icon_ticker_section.value == true %}
  <div class="icon-ticker-wrapper-{{ section.id }}">
    <div class="icon-ticker-{{ section.id }} multiple-items-{{ section.id }}">
      {{ ticker_content }}
      {% if section.blocks.size < 6 %}
        {{ ticker_content }}
      {% endif %}
    </div>
  </div>
{% endif %}

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const initTicker = () => {
      if (typeof jQuery === 'undefined' || typeof $.fn.slick === 'undefined') {
        setTimeout(initTicker, 100);
        return;
      }

      const $ticker = $('.multiple-items-{{ section.id }}');

      if ($ticker.hasClass('slick-initialized')) return;

      $ticker.slick({
        infinite: true,
        slidesToShow: 5,
        slidesToScroll: 1,
        autoplay: true,
        autoplaySpeed: 0,
        speed: 6000,
        cssEase: 'linear',
        arrows: false,
        dots: false,
        pauseOnHover: false,
        pauseOnFocus: false,
        variableWidth: true,
        responsive: [
          {
            breakpoint: 1024,
            settings: { slidesToShow: 3 }
          },
          {
            breakpoint: 768,
            settings: { slidesToShow: 2 }
          }
        ]
      });
    };

    initTicker();
  });
</script>

{% schema %}
{
  "name": "Icon Ticker Slider",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "transparent"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Ticker Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Treat Your Skin"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Icon Ticker Slider",
      "blocks": [
        { "type": "item", "settings": { "text": "Pataben Free" } },
        { "type": "item", "settings": { "text": "Treat Your Skin" } },
        { "type": "item", "settings": { "text": "Beauty That Glows" } },
        { "type": "item", "settings": { "text": "Vegan" } },
        { "type": "item", "settings": { "text": "Cruelty Free Beauty" } }
      ]
    }
  ]
}
{% endschema %}
