{% render 'breadcrumbs' %}

{% liquid
  assign enable_zoom = section.settings.enable_zoom
  assign enable_cart_redirection = section.settings.enable_cart_redirection
  assign images_layout_desktop = section.settings.images_layout_desktop | default: 'slideshow'
  assign images_layout_mobile = section.settings.images_layout_mobile | default: 'slideshow'
  assign images_layout = images_layout_desktop
  assign enable_video_autoplay = section.settings.enable_video_autoplay
  assign enable_video_looping = section.settings.enable_video_looping
  assign enable_linked_options = true
  assign show_vendor = settings.show_vendor
  assign show_social_media_icons = section.settings.show_social_media_icons
  assign show_payment_button = section.settings.show_payment_button
  assign notify_me_url = 'https://lindisimany.com/pages/notify-me'

  for block in section.blocks
    if block.type == 'complementary_products'
      assign product_recommendation_limit = block.settings.product_recommendation_limit
      break
    endif
  endfor
%}

{% if images_layout == 'masonry' %}
  {% assign related_products_position_right = false %}
{% endif %}

<script
  type="application/json"
  data-section-type="product"
  data-section-id="{{ section.id }}"
  data-section-data
>
  {
    "product": {{ product | json }},
    "product_settings": {
      "addToCartText": {{ 'products.product.add_to_cart' | t | json }},
      "enableHistory": true,
      "processingText": {{ 'products.product.processing' | t | json }},
      "setQuantityText": {{ 'products.product.set_quantity' | t | json }},
      "soldOutText": {{ 'products.product.sold_out' | t | json }},
      "unavailableText": {{ 'products.product.unavailable' | t | json }}
    },
    "images_layout": {{ images_layout | json }},
    "images_layout_desktop": {{ images_layout_desktop | json }},
    "images_layout_mobile": {{ images_layout_mobile | json }},
    "enable_zoom": {{ enable_zoom | json }},
    "enable_video_autoplay": {{ enable_video_autoplay | json }},
    "enable_video_looping": {{ enable_video_looping | json }},
    "enable_cart_redirection": {{ enable_cart_redirection | json }},
    "enable_fixed_positioning": true,
    "product_recommendation_limit": {{ product_recommendation_limit | json }}
  }
</script>

{% render 'product-success-labels' %}

<section
  class="product-container{% unless product.available %} product-container--sold-out{% endunless %}"
  data-section-id="{{ section.id }}"
  data-images-layout-desktop="{{ images_layout_desktop }}"
  data-images-layout-mobile="{{ images_layout_mobile }}"
>
  {%
    render 'product',
    product: product,
    enable_zoom: enable_zoom,
    images_layout: images_layout_desktop,
    images_layout_desktop: images_layout_desktop,
    images_layout_mobile: images_layout_mobile,
    enable_linked_options: enable_linked_options,
    show_vendor: show_vendor,
    show_social_media_icons: show_social_media_icons,
    show_payment_button: show_payment_button
  %}

  <div
    class="product-recommendations-wrapper--right"
    data-product-recommendations-right
  >
  </div>
</section>

{% unless product.available %}
  <div class="product-oos-wrapper">
    <span class="product-oos-label">Sold Out </span>
  </div>
{% endunless %}

<style>
  .product-oos-wrapper {
    display: flex;
    justify-content: flex-start;
    padding: 0;
    margin: 16px 0 0 0;
  }

  .product-oos-label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #e02020;
    color: #fff;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 4px 8px;
    border-radius: 4px;
    line-height: 1;
    pointer-events: none;
  }

  .product-container .notify-me-button {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 100% !important;
    background-color: #000 !important;
    color: #fff !important;
    font-size: 14px !important;
    font-weight: 700 !important;
    letter-spacing: 0.02em !important;
    text-transform: none !important;
    padding: 12px 18px !important;
    border-radius: 0 !important;
    line-height: 1 !important;
    text-decoration: none !important;
    border: 1px solid #000 !important;
    cursor: pointer !important;
    box-shadow: none !important;
    text-shadow: none !important;
    box-sizing: border-box !important;
  }

  .product-container .notify-me-button:hover {
    background-color: #111 !important;
    color: #fff !important;
  }

  .product-container--sold-out .shopify-payment-button,
  .product-container--sold-out .shopify-payment-button__button,
  .product-container--sold-out .shopify-payment-button__button--unbranded,
  .product-container--sold-out [data-shopify="payment-button"] {
    display: none !important;
  }

  .product-quickview-lightbox {
    display: none;
    position: fixed;
    z-index: 10000;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.9);
    justify-content: center;
    align-items: center;
    cursor: pointer;
  }

  .product-quickview-lightbox img {
    max-width: 90%;
    max-height: 90%;
    object-fit: contain;
    box-shadow: 0 0 20px rgba(0,0,0,0.5);
    cursor: default;
  }

  .product-quickview-close {
    position: absolute;
    top: 20px;
    right: 30px;
    color: #fff;
    font-size: 40px;
    font-weight: bold;
    cursor: pointer;
  }

  .product-container img {
    cursor: zoom-in !important;
  }

  .product-container form[action*="/cart/add"] button[type="submit"],
  .product-container form[action*="/cart/add"] input[type="submit"],
  .product-container .product-form__submit,
  .product-container .product-form--add-to-cart,
  .product-container .add-to-cart,
  .product-container .btn--add-to-cart,
  .product-container button[name="add"],
  .product-container [data-add-to-cart],
  .product-container .Primary-Btn {
    background-color: #e2cfce !important;
    border-color: #e2cfce !important;
    color: black !important;
    font-weight: bold !important;
    box-shadow: none !important;
    text-shadow: none !important;
    border-radius: 0 !important;
  }

  .product-container form[action*="/cart/add"] button[type="submit"]:hover,
  .product-container form[action*="/cart/add"] input[type="submit"]:hover,
  .product-container .product-form__submit:hover,
  .product-container .product-form--add-to-cart:hover,
  .product-container .add-to-cart:hover,
  .product-container .btn--add-to-cart:hover,
  .product-container button[name="add"]:hover,
  .product-container [data-add-to-cart]:hover,
  .product-container .Primary-Btn:hover {
    background-color: #a8b2a2 !important;
    border-color: #a8b2a2 !important;
    color: black !important;
    font-weight: bold !important;
    box-shadow: none !important;
    text-shadow: none !important;
  }
</style>

<div id="ProductQuickview" class="product-quickview-lightbox" onclick="closeQuickView()">
  <span class="product-quickview-close">&times;</span>
  <img id="QuickviewImage" src="" alt="Aperçu produit">
</div>

<script>
  const notifyMeUrl = {{ notify_me_url | json }};
  const sectionId = {{ section.id | json }};

  function openQuickView(src) {
    const lightbox = document.getElementById('ProductQuickview');
    const img = document.getElementById('QuickviewImage');
    img.src = src;
    lightbox.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }

  function closeQuickView() {
    const lightbox = document.getElementById('ProductQuickview');
    lightbox.style.display = 'none';
    document.body.style.overflow = '';
  }

  function upgradeSoldOutCta() {
    const productContainer = document.querySelector('.product-container--sold-out');
    if (!productContainer) return;

    const selectors = [
      'form[action*="/cart/add"] button[type="submit"]',
      'form[action*="/cart/add"] input[type="submit"]',
      '.product-form__submit',
      '.product-form--add-to-cart',
      '.add-to-cart',
      '.btn--add-to-cart',
      'button[name="add"]',
      '[data-add-to-cart]',
      '.Primary-Btn'
    ];

    selectors.forEach((selector) => {
      productContainer.querySelectorAll(selector).forEach((el) => {
        const text = ((el.textContent || el.value || '') + '').trim().toLowerCase();
        const isSoldOutButton =
          el.disabled ||
          el.getAttribute('aria-disabled') === 'true' ||
          text.includes('sold out') ||
          text.includes('out of stock') ||
          text.includes('unavailable');

        if (!isSoldOutButton) return;

        const notifyLink = document.createElement('a');
        notifyLink.href = notifyMeUrl;
        notifyLink.className = 'notify-me-button';
        notifyLink.setAttribute('role', 'button');
        notifyLink.setAttribute('aria-label', 'Notify Me');
        notifyLink.textContent = 'Notify Me';

        el.replaceWith(notifyLink);
      });
    });
  }

  function applyResponsiveLayoutFlag() {
    const root = document.querySelector('[data-section-id="' + sectionId + '"]');
    if (!root) return;

    const isMobile = window.matchMedia('(max-width: 749px)').matches;
    const desktopLayout = root.getAttribute('data-images-layout-desktop') || 'slideshow';
    const mobileLayout = root.getAttribute('data-images-layout-mobile') || desktopLayout;

    root.setAttribute('data-images-layout-active', isMobile ? mobileLayout : desktopLayout);
    root.classList.remove('layout-slideshow', 'layout-list', 'layout-masonry');
    root.classList.add('layout-' + (isMobile ? mobileLayout : desktopLayout));
  }

  document.addEventListener('DOMContentLoaded', function() {
    applyResponsiveLayoutFlag();

    const productContainer = document.querySelector('.product-container');
    if (productContainer) {
      productContainer.addEventListener('click', function(e) {
        const target = e.target;
        if (target.tagName === 'IMG') {
          let imgSrc = target.currentSrc || target.src;
          imgSrc = imgSrc.replace(/(_small|_medium|_large|_grande|_compact|_\d+x\d*)/g, '_2048x');
          openQuickView(imgSrc);
          e.preventDefault();
        }
      });
    }

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeQuickView();
    });

    const oosWrapper = document.querySelector('.product-oos-wrapper');
    if (oosWrapper) {
      const titleSelectors = [
        '.product-container .product-title',
        '.product-container .product__title',
        '.product-container h1.title',
        '.product-container h1',
        '.product-container [class*="product-title"]',
        '.product-container [class*="product__title"]'
      ];

      let titleEl = null;
      for (let sel of titleSelectors) {
        titleEl = document.querySelector(sel);
        if (titleEl) break;
      }

      if (titleEl) {
        titleEl.parentNode.insertBefore(oosWrapper, titleEl);
      }
    }

    upgradeSoldOutCta();
  });

  window.addEventListener('resize', applyResponsiveLayoutFlag);
  window.addEventListener('load', upgradeSoldOutCta);
</script>

