<header class="site-header">
  <div class="header-container">
    <div class="header-left">
      <div class="logo">
        <a href="/">
          {% if section.settings.logo_image != blank %}
            <img src="{{ section.settings.logo_image | img_url: 'medium' }}" alt="{{ shop.name }}">
          {% else %}
            {{ shop.name }}
          {% endif %}
        </a>
      </div>
    </div>
    <div class="header-center">
      <div class="mobile-menu-trigger" onclick="toggleMobileMenu()">
        <span></span>
        <span></span>
        <span></span>
      </div>

      <nav class="navigation desktop-only">
        {% for link in linklists[section.settings.main_menu].links %}
          {% if link.links.size > 0 %}
            <div class="dropdown-menu">
              <a href="{{ link.url }}" class="dropdown-toggle">{{ link.title }}</a>
              <div class="dropdown-content">
                {% for sublink in link.links %}
                  {% if sublink.links.size > 0 %}
                    <div class="submenu-item">
                      <a href="{{ sublink.url }}" class="submenu-toggle">{{ sublink.title }}<span class="submenu-arrow">&#9654;</span></a>
                      <div class="subsubmenu-content">
                        {% for subsublink in sublink.links %}
                          <a href="{{ subsublink.url }}" class="subsubmenu-link">{{ subsublink.title }}</a>
                        {% endfor %}
                      </div>
                    </div>
                  {% else %}
                    <a href="{{ sublink.url }}">{{ sublink.title }}</a>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          {% else %}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {% endif %}
        {% endfor %}
      </nav>
    </div>
    <div class="header-left header-left-mobile" style='display : none;'>
      <div class="mobile-menu-trigger" onclick="toggleMobileMenu()">
        <span></span>
        <span></span>
        <span></span>
      </div>

      <nav class="navigation desktop-only">
        {% for link in linklists[section.settings.main_menu].links %}
          {% if link.links.size > 0 %}
            <div class="dropdown-menu">
              <a href="{{ link.url }}" class="dropdown-toggle">{{ link.title }}</a>
              <div class="dropdown-content">
                {% for sublink in link.links %}
                  {% if sublink.links.size > 0 %}
                    <div class="submenu-item">
                      <a href="{{ sublink.url }}" class="submenu-toggle">{{ sublink.title }}<span class="submenu-arrow">&#9654;</span></a>
                      <div class="subsubmenu-content">
                        {% for subsublink in sublink.links %}
                          <a href="{{ subsublink.url }}" class="subsubmenu-link">{{ subsublink.title }}</a>
                        {% endfor %}
                      </div>
                    </div>
                  {% else %}
                    <a href="{{ sublink.url }}">{{ sublink.title }}</a>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          {% else %}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {% endif %}
        {% endfor %}
      </nav>
    </div>
    <div class="header-center header-center-mobile" style='display : none;'>
      <div class="logo">
        <a href="/">
          {% if section.settings.logo_image != blank %}
            <img src="{{ section.settings.logo_image | img_url: 'medium' }}" alt="{{ shop.name }}">
          {% else %}
            {{ shop.name }}
          {% endif %}
        </a>
      </div>
    </div>
    <div class="header-right">
      {% if section.settings.show_search %}
        <a href="/search" class="icon-link">
          <img src="https://cdn.shopify.com/s/files/1/0790/8232/4206/files/Vector.png?v=1773398481" alt="Search" class="custom-icon">
        </a>
      {% endif %}

      {% if section.settings.show_account %}
        <a href="/account" class="icon-account desktop-only" style="display: flex; width: 20px;">
          <img src="https://cdn.shopify.com/s/files/1/0790/8232/4206/files/Group.png?v=1773398480" alt="Account" class="custom-icon">
        </a>
      {% endif %}

      {% if section.settings.show_cart %}
        <a href="/cart" class="icon-cart" id="cart-icon-link" onclick="openCartDrawer(event )">
          <img src="https://cdn.shopify.com/s/files/1/0790/8232/4206/files/Group_1.png?v=1773398481" alt="Cart" class="custom-icon">
          <span class="cart-count" {% if cart.item_count == 0 %}style="display:none;"{% endif %}>{{ cart.item_count }}</span>
        </a>
      {% endif %}
    </div>
  </div>
</header>

<!-- ═══════════════════════════════════════════
     CART DRAWER
════════════════════════════════════════════ -->
<div id="cart-drawer-overlay" class="cart-drawer-overlay" onclick="closeCartDrawer( )"></div>

<div id="cart-drawer" class="cart-drawer">
  <div class="cart-drawer-header">
    <h2 class="cart-drawer-title">Your Cart</h2>
    <button class="cart-drawer-close" onclick="closeCartDrawer()" aria-label="Close cart">&#10005;</button>
  </div>

  <div class="cart-drawer-body" id="cart-drawer-body">
    <!-- Items injected by JS -->
  </div>

  <div class="cart-drawer-footer" id="cart-drawer-footer">
    <!-- Total + buttons injected by JS -->
  </div>
</div>

<!-- ═══════════════════════════════════════════
     MOBILE SIDEBAR
════════════════════════════════════════════ -->
<div id="mobile-sidebar" class="mobile-sidebar">
  <div class="sidebar-header">
    <div class="close-icon" onclick="toggleMobileMenu(  )">&times;</div>
  </div>
  <nav class="sidebar-navigation">
    {% for link in linklists[section.settings.main_menu].links %}
      {% if link.links.size > 0 %}
        <div class="mobile-dropdown">
          <div class="mobile-dropdown-toggle">
            <a href="{{ link.url }}" class="mobile-dropdown-link">{{ link.title }}</a>
            <span class="dropdown-arrow" onclick="toggleMobileDropdown(event)">&#9660;</span>
          </div>
          <div class="mobile-dropdown-content" style="display: none;">
            {% for sublink in link.links %}
              {% if sublink.links.size > 0 %}
                <div class="mobile-submenu-item">
                  <div class="mobile-submenu-toggle">
                    <a href="{{ sublink.url }}" class="mobile-submenu-link-text">{{ sublink.title }}</a>
                    <span class="submenu-arrow" onclick="toggleMobileSubdropdown(event)">&#9660;</span>
                  </div>
                  <div class="mobile-subsubmenu-content" style="display: none;">
                    {% for subsublink in sublink.links %}
                      <a href="{{ subsublink.url }}" class="mobile-subsublink">{{ subsublink.title }}</a>
                    {% endfor %}
                  </div>
                </div>
              {% else %}
                <a href="{{ sublink.url }}" class="mobile-sublink">{{ sublink.title }}</a>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% else %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endif %}
    {% endfor %}
  </nav>
</div>
<div id="sidebar-overlay" class="sidebar-overlay" onclick="toggleMobileMenu()"></div>

<style>
  /* ── Header ── */
  .site-header {
    background-color: {{ section.settings.bg_color }};
    width: 100%;
    padding: 9px 0 11px 0;
    transition: background 0.3s ease;
  }
  .icon-cart {
    display: flex;
    position: relative;
    cursor: pointer;
  }
  .cart-count {
    position: absolute;
    top: -8px;
    right: -8px;
    background-color: #e00000;
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    min-width: 18px;
    height: 18px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    padding: 0 3px;
    pointer-events: none;
  }
  .header-container {
    max-width: 1820px;
    margin: 0 auto;
    padding: 0 10px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .header-left, .header-center, .header-right {
    flex: 1;
    display: flex;
    align-items: center;
  }
  .header-left .logo { width: 200px; }
  .header-left .logo img { width: 100%; }
  .header-center { justify-content: center; flex: 2; }
  .header-right { justify-content: flex-end; gap: 24px; }

  .navigation {
    display: flex;
    align-items: center;
    gap: 0;
    flex-wrap: nowrap;
  }
  .navigation a {
    color: {{ section.settings.text_color }};
    font-family: 'Roboto', sans-serif !important;
    font-weight: 700;
    font-size: 18px;
    line-height: 100%;
    letter-spacing: 3%;
    text-decoration: none;
    padding: 10px 16px;
    white-space: nowrap;
    transition: all 0.3s ease;
  }
  .navigation a:hover { opacity: 0.8; }

  /* ── Dropdowns ── */
  .dropdown-menu { position: relative; display: inline-block; }
  .dropdown-toggle { display: flex; align-items: center; gap: 5px; cursor: pointer; }
  .dropdown-toggle::after { content: '▼'; font-size: 10px; transition: transform 0.3s ease; }
  .dropdown-menu:hover .dropdown-toggle::after { transform: rotate(180deg); }
  .dropdown-content::before { content: ""; position: absolute; top: -15px; left: 0; width: 100%; height: 15px; }
  .dropdown-content {
    position: absolute;
    top: calc(100% + 5px);
    left: 0;
    background-color: {{ section.settings.bg_color }};
    min-width: 220px;
    box-shadow: 0 8px 16px rgba(0,0,0,0.1);
    z-index: 100;
    display: none;
    flex-direction: column;
    border-top: 2px solid {{ section.settings.text_color }};
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
  .dropdown-menu:hover .dropdown-content { display: flex; opacity: 1; visibility: visible; }
  .dropdown-content a {
    color: {{ section.settings.text_color }};
    padding: 14px 20px;
    text-decoration: none;
    font-size: 16px;
    font-weight: 600;
    display: block;
    border-bottom: 1px solid #f0f0f0;
    transition: background-color 0.2s ease;
  }
  .dropdown-content a:last-child { border-bottom: none; }
  .dropdown-content a:hover { background-color: rgba(0,0,0,0.05); }
  .submenu-item { position: relative; }
  .submenu-item::before { content: ""; position: absolute; top: 0; right: -15px; width: 15px; height: 100%; }
  .submenu-toggle { display: flex !important; justify-content: space-between !important; align-items: center !important; padding: 14px 20px !important; cursor: pointer; }
  .submenu-arrow { font-size: 10px; margin-left: 10px; transition: transform 0.3s ease; }
  .submenu-item:hover .submenu-arrow { transform: rotate(90deg); }
  .subsubmenu-content {
    position: absolute;
    top: 0;
    left: calc(100% + 5px);
    background-color: {{ section.settings.bg_color }};
    min-width: 200px;
    box-shadow: 0 8px 16px rgba(0,0,0,0.1);
    z-index: 101;
    display: none;
    flex-direction: column;
    border-left: 3px solid {{ section.settings.text_color }};
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
  .submenu-item:hover .subsubmenu-content { display: flex; opacity: 1; visibility: visible; }
  .subsubmenu-link {
    color: {{ section.settings.text_color }} !important;
    padding: 12px 20px !important;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    display: block !important;
    border-bottom: 1px solid #f0f0f0;
    transition: background-color 0.2s ease;
    margin: 0 !important;
  }
  .subsubmenu-link:last-child { border-bottom: none; }
  .subsubmenu-link:hover { background-color: rgba(0,0,0,0.05); }

  /* ── Logo / Icons ── */
  .logo a {
    font-size: 34px;
    font-weight: 800;
    color: {{ section.settings.logo_color }};
    text-decoration: none;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  .icon-link { display: flex; align-items: center; color: {{ section.settings.text_color }}; }
  .icon-link svg { stroke: {{ section.settings.text_color }}; }
  img.custom-icon { width: 23px; }

  /* ── Mobile sidebar ── */
  .mobile-sidebar {
    position: fixed;
    top: 0;
    left: -100%;
    width: 300px;
    height: 100%;
    background: #fff;
    z-index: 1000;
    transition: 0.3s ease;
    padding: 20px;
    box-shadow: 2px 0 10px rgba(0,0,0,0.1);
    overflow-y: auto;
  }
  .mobile-sidebar.active { left: 0; }
  .sidebar-overlay {
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background: rgba(0,0,0,0.5);
    display: none;
    z-index: 999;
  }
  .sidebar-overlay.active { display: block; }
  .sidebar-header { display: flex; justify-content: flex-end; margin-bottom: 30px; }
  .close-icon { font-size: 35px; cursor: pointer; color: {{ section.settings.text_color }}; }
  .sidebar-navigation a { display: block; padding: 15px 0; font-size: 18px; text-decoration: none; color: {{ section.settings.text_color }}; border-bottom: 1px solid #eee; }
  .mobile-dropdown { position: relative; }
  .mobile-dropdown-toggle { display: flex; justify-content: space-between; align-items: center; width: 100%; border-bottom: 1px solid #eee; }
  .mobile-dropdown-link { display: block; flex: 1; padding: 15px 0; font-size: 18px; text-decoration: none; color: {{ section.settings.text_color }}; }
  .dropdown-arrow { font-size: 12px; transition: transform 0.3s ease; margin-left: 10px; cursor: pointer; padding: 15px 0 15px 15px; }
  .dropdown-arrow.active { transform: rotate(180deg); }
  .mobile-dropdown-content { background-color: #f9f9f9; border-left: 3px solid {{ section.settings.text_color }}; margin-left: 10px; }
  .mobile-sublink { display: block; padding: 12px 15px !important; font-size: 16px; border-bottom: 1px solid #eee !important; margin: 0 !important; }
  .mobile-submenu-item { position: relative; }
  .mobile-submenu-toggle { display: flex; justify-content: space-between; align-items: center; width: 100%; padding: 0 15px; margin: 0; border-bottom: 1px solid #eee; }
  .mobile-submenu-link-text { display: block; flex: 1; padding: 12px 0; font-size: 16px; text-decoration: none; color: {{ section.settings.text_color }}; }
  .mobile-submenu-toggle .submenu-arrow { cursor: pointer; padding: 12px 0 12px 12px; }
  .mobile-submenu-toggle .submenu-arrow.active { transform: rotate(180deg); }
  .mobile-subsubmenu-content { background-color: #f0f0f0; border-left: 3px solid {{ section.settings.text_color }}; margin-left: 15px; }
  .mobile-subsublink { display: block; padding: 10px 15px !important; font-size: 14px; border-bottom: 1px solid #ddd !important; margin: 0 !important; color: {{ section.settings.text_color }} !important; }
  .mobile-menu-trigger { display: none; flex-direction: column; gap: 5px; cursor: pointer; }
  .mobile-menu-trigger span { width: 25px; height: 2px; background-color: {{ section.settings.text_color }}; }

  /* ════════════════════════════════════════
     CART DRAWER
  ════════════════════════════════════════ */
  .cart-drawer-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    z-index: 2000;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.35s ease, visibility 0.35s ease;
  }
  .cart-drawer-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .cart-drawer {
    position: fixed;
    top: 0;
    right: -420px;
    width: 420px;
    max-width: 100vw;
    height: 100%;
    background: #fff;
    z-index: 2001;
    display: flex;
    flex-direction: column;
    box-shadow: -4px 0 30px rgba(0, 0, 0, 0.15);
    transition: right 0.38s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .cart-drawer.active {
    right: 0;
  }

  .cart-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22px 24px 18px;
    border-bottom: 1px solid #ebebeb;
    flex-shrink: 0;
  }
  .cart-drawer-title {
    font-family: 'Roboto', sans-serif;
    font-size: 20px;
    font-weight: 700;
    margin: 0;
    color: #111;
    letter-spacing: 0.5px;
  }
  .cart-drawer-close {
    background: none;
    border: none;
    font-size: 20px;
    cursor: pointer;
    color: #555;
    line-height: 1;
    padding: 4px 6px;
    border-radius: 4px;
    transition: background 0.2s;
  }
  .cart-drawer-close:hover { background: #f2f2f2; }

  .cart-drawer-body {
    flex: 1;
    overflow-y: auto;
    padding: 16px 24px;
  }

  .cart-drawer-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: #888;
    font-size: 16px;
    gap: 12px;
  }
  .cart-drawer-empty svg {
    width: 52px;
    height: 52px;
    stroke: #ccc;
    fill: none;
  }

  .cart-drawer-item {
    display: flex;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid #f0f0f0;
    align-items: flex-start;
  }
  .cart-drawer-item:last-child { border-bottom: none; }

  .cart-item-image {
    width: 72px;
    height: 72px;
    object-fit: cover;
    border-radius: 6px;
    flex-shrink: 0;
    background: #f7f7f7;
  }
  .cart-item-image-placeholder {
    width: 72px;
    height: 72px;
    border-radius: 6px;
    background: #f0f0f0;
    flex-shrink: 0;
  }

  .cart-item-details { flex: 1; min-width: 0; }
  .cart-item-title {
    font-size: 14px;
    font-weight: 600;
    color: #111;
    margin: 0 0 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .cart-item-variant { font-size: 12px; color: #888; margin: 0 0 8px; }
  .cart-item-qty-row { display: flex; align-items: center; gap: 10px; }
  .cart-item-qty-btn {
    width: 26px;
    height: 26px;
    border: 1px solid #ddd;
    background: #fff;
    border-radius: 4px;
    font-size: 16px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
    color: #333;
    flex-shrink: 0;
  }
  .cart-item-qty-btn:hover { background: #f2f2f2; }
  .cart-item-qty { font-size: 14px; font-weight: 600; min-width: 20px; text-align: center; color: #111; }
  .cart-item-remove {
    font-size: 11px;
    color: #aaa;
    cursor: pointer;
    text-decoration: underline;
    background: none;
    border: none;
    padding: 0;
    margin-left: 4px;
    transition: color 0.2s;
  }
  .cart-item-remove:hover { color: #e00000; }
  .cart-item-price { font-size: 14px; font-weight: 700; color: #111; white-space: nowrap; flex-shrink: 0; padding-top: 2px; }

  .cart-drawer-footer {
    padding: 18px 24px 24px;
    border-top: 1px solid #ebebeb;
    flex-shrink: 0;
    background: #fff;
  }
  .cart-drawer-subtotal { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
  .cart-drawer-subtotal-label { font-size: 15px; font-weight: 600; color: #111; }
  .cart-drawer-subtotal-price { font-size: 18px; font-weight: 700; color: #111; }
  .cart-drawer-btn-checkout {
    display: block;
    width: 100%;
    padding: 14px;
    background: #111;
    color: #fff;
    font-size: 15px;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
    border-radius: 6px;
    border: none;
    cursor: pointer;
    transition: background 0.2s;
    margin-bottom: 10px;
    letter-spacing: 0.5px;
  }
  .cart-drawer-btn-checkout:hover { background: #333; }
  .cart-drawer-btn-view {
    display: block;
    width: 100%;
    padding: 12px;
    background: #fff;
    color: #111;
    font-size: 14px;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    border-radius: 6px;
    border: 1px solid #ddd;
    cursor: pointer;
    transition: background 0.2s;
    letter-spacing: 0.3px;
  }
  .cart-drawer-btn-view:hover { background: #f7f7f7; }

  .cart-drawer-loading { display: flex; align-items: center; justify-content: center; padding: 40px 0; }
  .cart-drawer-spinner {
    width: 32px;
    height: 32px;
    border: 3px solid #eee;
    border-top-color: #111;
    border-radius: 50%;
    animation: cd-spin 0.7s linear infinite;
  }
  @keyframes cd-spin { to { transform: rotate(360deg); } }

  /* ════════════════════════════════════════
     AUTOMATIC DISCOUNTS
  ════════════════════════════════════════ */
  .cart-item-price-wrap { text-align: right; flex-shrink: 0; padding-top: 2px; }
  .cart-item-price-original {
    display: block;
    font-size: 12px;
    color: #aaa;
    text-decoration: line-through;
    font-weight: 500;
    margin-bottom: 2px;
  }
  .cart-item-discount {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    color: #e00000;
    background: #ffecec;
    border: 1px solid #ffd2d2;
    border-radius: 4px;
    padding: 3px 7px;
    margin-top: 8px;
    margin-right: 6px;
    letter-spacing: 0.2px;
  }
  .cart-drawer-discounts { display: flex; flex-direction: column; gap: 8px; margin-bottom: 14px; }
  .cart-drawer-discount-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    font-weight: 700;
    color: #e00000;
    background: #ffecec;
    border: 1px solid #ffd2d2;
    border-radius: 6px;
    padding: 9px 12px;
  }
  .cart-drawer-savings {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    font-weight: 600;
    color: #e00000;
    margin-bottom: 10px;
  }
  .cart-drawer-subtotal-original {
    font-size: 14px;
    color: #aaa;
    text-decoration: line-through;
    font-weight: 500;
    margin-right: 8px;
  }

  /* ════════════════════════════════════════
     UPSELL / PROGRESS NOTE
  ════════════════════════════════════════ */
  .cart-upsell-note {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    background: #fff8e6;
    border: 1px solid #ffe2a8;
    border-radius: 8px;
    padding: 12px 14px;
    margin: 0 0 6px;
  }
  .cart-upsell-icon { font-size: 15px; line-height: 1.3; flex-shrink: 0; }
  .cart-upsell-body { flex: 1; min-width: 0; }
  .cart-upsell-text {
    font-size: 13px;
    font-weight: 600;
    color: #7a5b00;
    line-height: 1.45;
    margin: 0;
  }
  .cart-upsell-text strong { color: #b37700; font-weight: 800; }
  .cart-upsell-bar {
    height: 5px;
    background: #ffe2a8;
    border-radius: 3px;
    margin-top: 9px;
    overflow: hidden;
  }
  .cart-upsell-bar-fill {
    height: 100%;
    background: #e0a11a;
    border-radius: 3px;
    transition: width 0.4s ease;
  }
  .cart-upsell-note.is-unlocked { background: #eaf8ee; border-color: #bfe6ca; }
  .cart-upsell-note.is-unlocked .cart-upsell-text { color: #1c7a3c; }
  .cart-upsell-note.is-unlocked .cart-upsell-text strong { color: #14622f; }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .header-left { display: none !important; }
    .header-center { display: none !important; }
    .header-center.header-center-mobile { display: block !important; }
    .header-left.header-left-mobile { display: block !important; }
    .site-header { padding: 12px 0; }
    .desktop-only { display: none !important; }
    .mobile-menu-trigger { display: flex; }
    .header-left, .header-right { flex: 1; }
    .logo img { max-width: 170px; }
    /* .cart-drawer { width: 100vw; } */
    .header-center .logo{
      display: flex;
      justify-content: center;
      width: 100%;
    }
  }
  @media (min-width: 769px) {
    .mobile-menu-trigger { display: none; }
  }
</style>

<script>
  /* ════════════════════════════════════════
     CART BADGE HELPERS
  ════════════════════════════════════════ */
  function updateCartBadge(count) {
    var badge = document.querySelector('.cart-count');
    if (!badge) return;
    if (count > 0) {
      badge.textContent = count;
      badge.style.display = 'flex';
    } else {
      badge.style.display = 'none';
    }
  }

  function formatMoney(cents) {
    return (cents / 100).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  }

  function escapeHtml(str) {
    return String(str == null ? '' : str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  /* ════════════════════════════════════════
     UPSELL NOTE
  ════════════════════════════════════════ */
  var UPSELL = {
    enabled:   {{ section.settings.upsell_enabled | json }},
    threshold: {{ section.settings.upsell_threshold | default: 2 | json }},
    discount:  {{ section.settings.upsell_discount_label | json }},
    message:   {{ section.settings.upsell_message | json }},
    unlocked:  {{ section.settings.upsell_unlocked_message | json }}
  };

  function buildUpsellNote(cart) {
    if (!UPSELL.enabled) return '';

    var threshold = parseInt(UPSELL.threshold, 10);
    if (!threshold || threshold < 2) return '';

    var count     = cart.item_count || 0;
    var remaining = threshold - count;
    var isUnlocked = remaining <= 0;

    var template = isUnlocked ? UPSELL.unlocked : UPSELL.message;
    if (!template) return '';

    var text = escapeHtml(template)
      .split('{remaining}').join('<strong>' + Math.max(remaining, 0) + '</strong>')
      .split('{discount}').join('<strong>' + escapeHtml(UPSELL.discount || '') + '</strong>')
      .split('{s}').join(remaining > 1 ? 's' : '');

    var percent = Math.min(Math.round((count / threshold) * 100), 100);

    return '<div class="cart-upsell-note' + (isUnlocked ? ' is-unlocked' : '') + '">'
      + '<span class="cart-upsell-icon">' + (isUnlocked ? '&#10003;' : '&#127873;') + '</span>'
      + '<div class="cart-upsell-body">'
      +   '<p class="cart-upsell-text">' + text + '</p>'
      +   (isUnlocked ? '' :
            '<div class="cart-upsell-bar"><div class="cart-upsell-bar-fill" style="width:' + percent + '%"></div></div>')
      + '</div>'
      + '</div>';
  }

  /* ════════════════════════════════════════
     CART DRAWER
  ════════════════════════════════════════ */
  function openCartDrawer(e) {
    if (e) e.preventDefault();
    renderCartDrawer();
    document.getElementById('cart-drawer').classList.add('active');
    document.getElementById('cart-drawer-overlay').classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeCartDrawer() {
    document.getElementById('cart-drawer').classList.remove('active');
    document.getElementById('cart-drawer-overlay').classList.remove('active');
    document.body.style.overflow = '';
  }

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeCartDrawer();
  });

  function renderCartDrawer() {
    var body   = document.getElementById('cart-drawer-body');
    var footer = document.getElementById('cart-drawer-footer');
    body.innerHTML   = '<div class="cart-drawer-loading"><div class="cart-drawer-spinner"></div></div>';
    footer.innerHTML = '';

    fetch('/cart.js', { cache: 'no-store', headers: { 'Accept': 'application/json' } })
      .then(function(r) { return r.json(); })
      .then(function(cart) {
        updateCartBadge(cart.item_count);

        if (!cart.items || cart.items.length === 0) {
          body.innerHTML = '<div class="cart-drawer-empty">'
            + '<svg viewBox="0 0 24 24" stroke-width="1.5"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>'
            + '<span>Your cart is empty</span>'
            + '</div>';
          footer.innerHTML = '';
          return;
        }

        var itemsHtml = '';
        cart.items.forEach(function(item) {
          var imgHtml = item.image
            ? '<img class="cart-item-image" src="' + item.image + '" alt="' + escapeHtml(item.product_title) + '">'
            : '<div class="cart-item-image-placeholder"></div>';

          var variantHtml = (item.variant_title && item.variant_title !== 'Default Title')
            ? '<p class="cart-item-variant">' + escapeHtml(item.variant_title) + '</p>'
            : '';

          /* ── line-level automatic discounts ── */
          var allocs = item.line_level_discount_allocations || [];
          var discountHtml = '';
          allocs.forEach(function(d) {
            var title = (d.discount_application && d.discount_application.title) || 'Discount';
            discountHtml += '<span class="cart-item-discount">'
              + escapeHtml(title) + ' &minus;' + formatMoney(d.amount) + ' ' + cart.currency
              + '</span>';
          });

          var hasLineDiscount = item.original_line_price > item.final_line_price;
          var priceHtml = '<div class="cart-item-price-wrap">'
            + (hasLineDiscount
                ? '<span class="cart-item-price-original">' + formatMoney(item.original_line_price) + ' ' + cart.currency + '</span>'
                : '')
            + '<span class="cart-item-price">' + formatMoney(item.final_line_price) + ' ' + cart.currency + '</span>'
            + '</div>';

          itemsHtml += '<div class="cart-drawer-item" data-key="' + item.key + '">'
            + imgHtml
            + '<div class="cart-item-details">'
            +   '<p class="cart-item-title">' + escapeHtml(item.product_title) + '</p>'
            +   variantHtml
            +   '<div class="cart-item-qty-row">'
            +     '<button class="cart-item-qty-btn" onclick="changeQty(\'' + item.key + '\',' + (item.quantity - 1) + ')">&#8722;</button>'
            +     '<span class="cart-item-qty">' + item.quantity + '</span>'
            +     '<button class="cart-item-qty-btn" onclick="changeQty(\'' + item.key + '\',' + (item.quantity + 1) + ')">&#43;</button>'
            +     '<button class="cart-item-remove" onclick="changeQty(\'' + item.key + '\',0)">Remove</button>'
            +   '</div>'
            +   discountHtml
            + '</div>'
            + priceHtml
            + '</div>';
        });
        body.innerHTML = buildUpsellNote(cart) + itemsHtml;

        /* ── cart-level automatic discounts ── */
        var cartDiscounts = cart.cart_level_discount_applications || [];
        var discountsBlock = '';
        if (cartDiscounts.length) {
          discountsBlock += '<div class="cart-drawer-discounts">';
          cartDiscounts.forEach(function(d) {
            discountsBlock += '<div class="cart-drawer-discount-row">'
              + '<span>' + escapeHtml(d.title || 'Discount') + '</span>'
              + '<span>&minus;' + formatMoney(d.total_allocated_amount) + ' ' + cart.currency + '</span>'
              + '</div>';
          });
          discountsBlock += '</div>';
        }

        var savingsBlock = '';
        if (cart.total_discount > 0) {
          savingsBlock = '<div class="cart-drawer-savings">'
            + '<span>You save</span>'
            + '<span>&minus;' + formatMoney(cart.total_discount) + ' ' + cart.currency + '</span>'
            + '</div>';
        }

        var originalPrice = (cart.original_total_price > cart.total_price)
          ? '<span class="cart-drawer-subtotal-original">' + formatMoney(cart.original_total_price) + ' ' + cart.currency + '</span>'
          : '';

        footer.innerHTML = discountsBlock
          + savingsBlock
          + '<div class="cart-drawer-subtotal">'
          +   '<span class="cart-drawer-subtotal-label">Subtotal</span>'
          +   '<span>' + originalPrice
          +     '<span class="cart-drawer-subtotal-price">' + formatMoney(cart.total_price) + ' ' + cart.currency + '</span>'
          +   '</span>'
          + '</div>'
          + '<a href="/checkout" class="cart-drawer-btn-checkout">Checkout</a>'
          + '<a href="/cart" class="cart-drawer-btn-view" onclick="closeCartDrawer()">View Cart</a>';
      })
      .catch(function() {
        body.innerHTML = '<p style="padding:20px;color:#888;">Could not load cart.</p>';
      });
  }

  function changeQty(key, qty) {
    fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: key, quantity: qty })
    })
    .then(function(r) { return r.json(); })
    .then(function() { renderCartDrawer(); })
    .catch(function() { renderCartDrawer(); });
  }

  /* ════════════════════════════════════════
     INTERCEPT ADD-TO-CART → OPEN DRAWER
  ════════════════════════════════════════ */
  function fetchCartCount() {
    fetch('/cart.js', { cache: 'no-store' })
      .then(function(r) { return r.json(); })
      .then(function(cart) { updateCartBadge(cart.item_count); })
      .catch(function() {});
  }

  document.addEventListener('cart:updated', function(e) {
    var count = e.detail && e.detail.cart ? e.detail.cart.item_count : null;
    if (count !== null) updateCartBadge(count);
    else fetchCartCount();
  });

  (function() {
    var _fetch = window.fetch;
    window.fetch = function() {
      var url = arguments[0];
      if (url && typeof url === 'object' && url.url) url = url.url;

      var isAdd    = typeof url === 'string' && url.indexOf('/cart/add') !== -1;
      var isChange = typeof url === 'string' && (
        url.indexOf('/cart/change') !== -1 ||
        url.indexOf('/cart/update') !== -1 ||
        url.indexOf('/cart/clear')  !== -1
      );

      var result = _fetch.apply(this, arguments);

      if (isAdd) {
        result.then(function(response) {
          var clone = response.clone();
          clone.json().then(function() {
            openCartDrawer();
          }).catch(function() { fetchCartCount(); });
        }).catch(function() {});
      } else if (isChange) {
        result.then(function(response) {
          var clone = response.clone();
          clone.json().then(function(data) {
            if (data.item_count !== undefined) updateCartBadge(data.item_count);
            else fetchCartCount();
          }).catch(function() { fetchCartCount(); });
        }).catch(function() {});
      }

      return result;
    };
  })();

  (function() {
    var _open = XMLHttpRequest.prototype.open;
    var _send = XMLHttpRequest.prototype.send;
    XMLHttpRequest.prototype.open = function(method, url) {
      this._xhrUrl = url;
      return _open.apply(this, arguments);
    };
    XMLHttpRequest.prototype.send = function() {
      var url = this._xhrUrl || '';
      var isAdd = typeof url === 'string' && url.indexOf('/cart/add') !== -1;
      var isChange = typeof url === 'string' && (
        url.indexOf('/cart/change') !== -1 ||
        url.indexOf('/cart/update') !== -1 ||
        url.indexOf('/cart/clear')  !== -1
      );
      if (isAdd) {
        this.addEventListener('load', function() { openCartDrawer(); });
      } else if (isChange) {
        this.addEventListener('load', function() { fetchCartCount(); });
      }
      return _send.apply(this, arguments);
    };
  })();

  /* ════════════════════════════════════════
     MOBILE MENU
  ════════════════════════════════════════ */
  function toggleMobileMenu() {
    const sidebar = document.getElementById('mobile-sidebar');
    const overlay = document.getElementById('sidebar-overlay');
    sidebar.classList.toggle('active');
    overlay.classList.toggle('active');
    if (sidebar.classList.contains('active')) {
      document.body.style.overflow = 'hidden';
    } else {
      document.body.style.overflow = '';
    }
  }

  function toggleMobileDropdown(event) {
    event.preventDefault();
    event.stopPropagation();
    const arrow   = event.currentTarget;
    const toggle  = arrow.closest('.mobile-dropdown-toggle');
    const content = toggle.nextElementSibling;
    arrow.classList.toggle('active');
    content.style.display = (content.style.display === 'none' || content.style.display === '') ? 'block' : 'none';
  }

  function toggleMobileSubdropdown(event) {
    event.preventDefault();
    event.stopPropagation();
    const arrow   = event.currentTarget;
    const toggle  = arrow.closest('.mobile-submenu-toggle');
    const content = toggle.nextElementSibling;
    arrow.classList.toggle('active');
    content.style.display = (content.style.display === 'none' || content.style.display === '') ? 'block' : 'none';
  }
</script>

{% schema %}
{
  "name": "Header Custom",
  "settings": [
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text/Icon Color", "default": "#717568" },
    { "type": "color", "id": "logo_color", "label": "Logo Color", "default": "#000000" },
    { "type": "header", "content": "Layout" },
    { "type": "link_list", "id": "main_menu", "label": "Select Menu" },
    { "type": "image_picker", "id": "logo_image", "label": "Logo Image" },
    {
      "type": "select",
      "id": "logo_position",
      "label": "Logo Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    { "type": "header", "content": "Icons" },
    { "type": "checkbox", "id": "show_search", "label": "Show Search Icon", "default": true },
    { "type": "checkbox", "id": "show_account", "label": "Show Account Icon", "default": true },
    { "type": "checkbox", "id": "show_cart", "label": "Show Cart Icon", "default": true },
    { "type": "header", "content": "Cart Upsell Note" },
    { "type": "checkbox", "id": "upsell_enabled", "label": "Show upsell note in cart drawer", "default": true },
    { "type": "number", "id": "upsell_threshold", "label": "Items needed to unlock", "default": 2, "info": "Counts total quantity in the cart, not distinct products." },
    { "type": "text", "id": "upsell_discount_label", "label": "Discount label", "default": "15%" },
    { "type": "text", "id": "upsell_message", "label": "Message before unlocking", "default": "Add {remaining} more item{s} and get {discount} off your order!", "info": "Placeholders: {remaining}, {s} for the plural, {discount}." },
    { "type": "text", "id": "upsell_unlocked_message", "label": "Message after unlocking", "info": "Leave empty so the note disappears once unlocked. Fill it in to show a green confirmation instead." }
  ],
  "presets": [{ "name": "Header Custom" }]
}
{% endschema %}
