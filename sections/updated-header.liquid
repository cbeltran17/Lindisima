<header class="site-header">
  <div class="header-container">
    <div class="header-left">
      <div class="logo">
        <a href="/">
          {% if section.settings.logo_image != blank %}
            <img src="{{ section.settings.logo_image | img_url: 'medium' }}" alt="{{ shop.name }}">
          {% else %}
            {{ shop.name }}
          {% endif %}
        </a>
      </div>
    </div>
    <div class="header-center">
      <div class="mobile-menu-trigger" onclick="toggleMobileMenu()">
        <span></span>
        <span></span>
        <span></span>
      </div>
      
      <nav class="navigation desktop-only">
        {% for link in linklists[section.settings.main_menu].links %}
          {% if link.links.size > 0 %}
            <div class="dropdown-menu">
              <a href="{{ link.url }}" class="dropdown-toggle">{{ link.title }}</a>
              <div class="dropdown-content">
                {% for sublink in link.links %}
                  {% if sublink.links.size > 0 %}
                    <div class="submenu-item">
                      <a href="{{ sublink.url }}" class="submenu-toggle">{{ sublink.title }}<span class="submenu-arrow">▶</span></a>
                      <div class="subsubmenu-content">
                        {% for subsublink in sublink.links %}
                          <a href="{{ subsublink.url }}" class="subsubmenu-link">{{ subsublink.title }}</a>
                        {% endfor %}
                      </div>
                    </div>
                  {% else %}
                    <a href="{{ sublink.url }}">{{ sublink.title }}</a>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          {% else %}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {% endif %}
        {% endfor %}
      </nav>
    </div>
    <div class="header-left header-left-mobile" style='display : none;'>
      <div class="mobile-menu-trigger" onclick="toggleMobileMenu()">
        <span></span>
        <span></span>
        <span></span>
      </div>
      
      <nav class="navigation desktop-only">
        {% for link in linklists[section.settings.main_menu].links %}
          {% if link.links.size > 0 %}
            <div class="dropdown-menu">
              <a href="{{ link.url }}" class="dropdown-toggle">{{ link.title }}</a>
              <div class="dropdown-content">
                {% for sublink in link.links %}
                  {% if sublink.links.size > 0 %}
                    <div class="submenu-item">
                      <a href="{{ sublink.url }}" class="submenu-toggle">{{ sublink.title }}<span class="submenu-arrow">▶</span></a>
                      <div class="subsubmenu-content">
                        {% for subsublink in sublink.links %}
                          <a href="{{ subsublink.url }}" class="subsubmenu-link">{{ subsublink.title }}</a>
                        {% endfor %}
                      </div>
                    </div>
                  {% else %}
                    <a href="{{ sublink.url }}">{{ sublink.title }}</a>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          {% else %}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {% endif %}
        {% endfor %}
      </nav>
    </div>
    <div class="header-center header-center-mobile" style='display : none;'>
      <div class="logo">
        <a href="/">
          {% if section.settings.logo_image != blank %}
            <img src="{{ section.settings.logo_image | img_url: 'medium' }}" alt="{{ shop.name }}">
          {% else %}
            {{ shop.name }}
          {% endif %}
        </a>
      </div>
    </div>
    <div class="header-right">
      {% if section.settings.show_search %}
        <a href="/search" class="icon-link">
          <img src="https://cdn.shopify.com/s/files/1/0790/8232/4206/files/Vector.png?v=1773398481" alt="Search" class="custom-icon">
        </a>
      {% endif %}
      
      {% if section.settings.show_account %}
        <a href="/account" class="icon-account desktop-only" style="display: flex; width: 20px;">
          <img src="https://cdn.shopify.com/s/files/1/0790/8232/4206/files/Group.png?v=1773398480" alt="Account" class="custom-icon">
        </a>
      {% endif %}

      {% if section.settings.show_cart %}
        <a href="/cart" class="icon-cart">
          <img src="https://cdn.shopify.com/s/files/1/0790/8232/4206/files/Group_1.png?v=1773398481" alt="Cart" class="custom-icon">
          {% if cart.item_count > 0 %}
            <span class="cart-count">{{ cart.item_count }}</span>
          {% endif %}
        </a>
      {% endif %}
    </div>
  </div>
</header>

<div id="mobile-sidebar" class="mobile-sidebar">
  <div class="sidebar-header">
    <div class="close-icon" onclick="toggleMobileMenu(   )">&times;</div>
  </div>
  <nav class="sidebar-navigation">
    {% for link in linklists[section.settings.main_menu].links %}
      {% if link.links.size > 0 %}
        <div class="mobile-dropdown">
          <a href="{{ link.url }}" class="mobile-dropdown-toggle" onclick="toggleMobileDropdown(event)">{{ link.title }}<span class="dropdown-arrow">▼</span></a>
          <div class="mobile-dropdown-content" style="display: none;">
            {% for sublink in link.links %}
              {% if sublink.links.size > 0 %}
                <div class="mobile-submenu-item">
                  <a href="{{ sublink.url }}" class="mobile-submenu-toggle" onclick="toggleMobileSubdropdown(event)">{{ sublink.title }}<span class="submenu-arrow">▼</span></a>
                  <div class="mobile-subsubmenu-content" style="display: none;">
                    {% for subsublink in sublink.links %}
                      <a href="{{ subsublink.url }}" class="mobile-subsublink">{{ subsublink.title }}</a>
                    {% endfor %}
                  </div>
                </div>
              {% else %}
                <a href="{{ sublink.url }}" class="mobile-sublink">{{ sublink.title }}</a>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% else %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endif %}
    {% endfor %}
  </nav>
</div>
<div id="sidebar-overlay" class="sidebar-overlay" onclick="toggleMobileMenu()"></div>

<style>
  .site-header {
    background-color: {{ section.settings.bg_color }};
    width: 100%;
    padding: 9px 0 11px 0;
    transition: background 0.3s ease;
  }
  .icon-cart{
    display: flex;
    position: relative;
  }
  .cart-count {
    position: absolute;
    top: -8px;
    right: -8px;
    background-color: #e00000;
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    min-width: 18px;
    height: 18px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    padding: 0 3px;
    pointer-events: none;
  }
  .header-container {
    max-width: 1820px;
    margin: 0 auto;
    padding: 0 10px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .header-left, .header-center, .header-right {
    flex: 1;
    display: flex;
    align-items: center;
  }
  .header-left .logo{
    width: 200px;
  }
  .header-left .logo img{
    width: 100%;
  }
  .header-center { 
    justify-content: center;
    flex: 2;
  }
  .header-right { 
    justify-content: flex-end; 
    gap: 24px; 
  }

  .navigation {
    display: flex;
    align-items: center;
    gap: 0;
    flex-wrap: nowrap;
  }

  .navigation a {
    color: {{ section.settings.text_color }};
    font-family: 'Roboto', sans-serif !important;
    font-weight: 700;
    font-size: 18px;
    line-height: 100%;
    letter-spacing: 3%;
    text-decoration: none;
    padding: 10px 16px;
    white-space: nowrap;
    transition: all 0.3s ease;
  }

  .navigation a:hover {
    opacity: 0.8;
  }

  /* Dropdown Menu Styles */
  .dropdown-menu {
    position: relative;
    display: inline-block;
  }

  .dropdown-toggle {
    display: flex;
    align-items: center;
    gap: 5px;
    cursor: pointer;
  }

  .dropdown-toggle::after {
    content: '▼';
    font-size: 10px;
    transition: transform 0.3s ease;
  }

  .dropdown-menu:hover .dropdown-toggle::after {
    transform: rotate(180deg);
  }

  /* Zone tampon pour éviter la fermeture au survol */
  .dropdown-content::before {
    content: "";
    position: absolute;
    top: -15px;
    left: 0;
    width: 100%;
    height: 15px;
  }

  .dropdown-content {
    position: absolute;
    top: calc(100% + 5px);
    left: 0;
    background-color: {{ section.settings.bg_color }};
    min-width: 220px;
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
    z-index: 100;
    display: none;
    flex-direction: column;
    border-top: 2px solid {{ section.settings.text_color }};
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .dropdown-menu:hover .dropdown-content {
    display: flex;
    opacity: 1;
    visibility: visible;
  }

  .dropdown-content a {
    color: {{ section.settings.text_color }};
    padding: 14px 20px;
    text-decoration: none;
    font-size: 16px;
    font-weight: 600;
    display: block;
    border-bottom: 1px solid #f0f0f0;
    transition: background-color 0.2s ease;
  }

  .dropdown-content a:last-child {
    border-bottom: none;
  }

  .dropdown-content a:hover {
    background-color: rgba(0, 0, 0, 0.05);
  }

  /* Submenu Item Styles (for items with subsubmenus) */
  .submenu-item {
    position: relative;
  }

  .submenu-item::before {
    content: "";
    position: absolute;
    top: 0;
    right: -15px;
    width: 15px;
    height: 100%;
  }

  .submenu-toggle {
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    padding: 14px 20px !important;
    cursor: pointer;
  }

  .submenu-arrow {
    font-size: 10px;
    margin-left: 10px;
    transition: transform 0.3s ease;
  }

  .submenu-item:hover .submenu-arrow {
    transform: rotate(90deg);
  }

  /* Subsubmenu Content Styles */
  .subsubmenu-content {
    position: absolute;
    top: 0;
    left: calc(100% + 5px);
    background-color: {{ section.settings.bg_color }};
    min-width: 200px;
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
    z-index: 101;
    display: none;
    flex-direction: column;
    border-left: 3px solid {{ section.settings.text_color }};
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .submenu-item:hover .subsubmenu-content {
    display: flex;
    opacity: 1;
    visibility: visible;
  }

  .subsubmenu-link {
    color: {{ section.settings.text_color }} !important;
    padding: 12px 20px !important;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    display: block !important;
    border-bottom: 1px solid #f0f0f0;
    transition: background-color 0.2s ease;
    margin: 0 !important;
  }

  .subsubmenu-link:last-child {
    border-bottom: none;
  }

  .subsubmenu-link:hover {
    background-color: rgba(0, 0, 0, 0.05);
  }

  .logo a {
    font-size: 34px;
    font-weight: 800;
    color: {{ section.settings.logo_color }};
    text-decoration: none;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .icon-link {
    display: flex;
    align-items: center;
    color: {{ section.settings.text_color }};
  }

  .icon-link svg {
    stroke: {{ section.settings.text_color }};
  }
  
  .mobile-sidebar {
    position: fixed;
    top: 0;
    left: -100%;
    width: 300px;
    height: 100%;
    background: #fff;
    z-index: 1000;
    transition: 0.3s ease;
    padding: 20px;
    box-shadow: 2px 0 10px rgba(0,0,0,0.1);
    overflow-y: auto;
  }
  
  img.custom-icon{
    width: 23px;
  }
  
  .mobile-sidebar.active {
    left: 0;
  }

  .sidebar-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.5);
    display: none;
    z-index: 999;
  }

  .sidebar-overlay.active {
    display: block;
  }

  .sidebar-header {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 30px;
  }

  .close-icon {
    font-size: 35px;
    cursor: pointer;
    color: {{ section.settings.text_color }};
  }

  .sidebar-navigation a {
    display: block;
    padding: 15px 0;
    font-size: 18px;
    text-decoration: none;
    color: {{ section.settings.text_color }};
    border-bottom: 1px solid #eee;
  }

  .mobile-dropdown {
    position: relative;
  }

  .mobile-dropdown-toggle {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    padding: 15px 0 !important;
    cursor: pointer;
  }

  .dropdown-arrow {
    font-size: 12px;
    transition: transform 0.3s ease;
    margin-left: 10px;
  }

  .mobile-dropdown-toggle.active .dropdown-arrow {
    transform: rotate(180deg);
  }

  .mobile-dropdown-content {
    background-color: #f9f9f9;
    border-left: 3px solid {{ section.settings.text_color }};
    margin-left: 10px;
  }

  .mobile-sublink {
    display: block;
    padding: 12px 15px !important;
    font-size: 16px;
    border-bottom: 1px solid #eee !important;
    margin: 0 !important;
  }

  /* Mobile Submenu Item Styles */
  .mobile-submenu-item {
    position: relative;
  }

  .mobile-submenu-toggle {
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    width: 100% !important;
    padding: 12px 15px !important;
    cursor: pointer;
    font-size: 16px !important;
    margin: 0 !important;
    border-bottom: 1px solid #eee !important;
  }

  .mobile-submenu-toggle.active .submenu-arrow {
    transform: rotate(180deg);
  }

  .mobile-subsubmenu-content {
    background-color: #f0f0f0;
    border-left: 3px solid {{ section.settings.text_color }};
    margin-left: 15px;
  }

  .mobile-subsublink {
    display: block;
    padding: 10px 15px !important;
    font-size: 14px;
    border-bottom: 1px solid #ddd !important;
    margin: 0 !important;
    color: {{ section.settings.text_color }} !important;
  }

  .mobile-menu-trigger {
    display: none;
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
  }

  .mobile-menu-trigger span {
    width: 25px;
    height: 2px;
    background-color: {{ section.settings.text_color }};
  }

  @media (max-width: 768px) {
    .header-left{ display: none !important; }
    .header-center{ display: none !important; }
    .header-center.header-center-mobile { display: block !important; }
    .header-left.header-left-mobile { display: block !important; }
    .site-header{ padding: 12px 0; }
    .desktop-only { display: none !important; }
    .mobile-menu-trigger { display: flex; }
    .header-left, .header-right { flex: 1; }
    .logo img { max-width: 150px; }
  }

  @media (min-width: 769px) {
    .mobile-menu-trigger { display: none; }
  }
</style>

<script>
  function toggleMobileMenu() {
    const sidebar = document.getElementById('mobile-sidebar');
    const overlay = document.getElementById('sidebar-overlay');
    sidebar.classList.toggle('active');
    overlay.classList.toggle('active');
    if (sidebar.classList.contains('active')) {
      document.body.style.overflow = 'hidden';
    } else {
      document.body.style.overflow = '';
    }
  }

  function toggleMobileDropdown(event) {
    event.preventDefault();
    const toggle = event.currentTarget;
    const content = toggle.nextElementSibling;
    toggle.classList.toggle('active');
    if (content.style.display === 'none' || content.style.display === '') {
      content.style.display = 'block';
    } else {
      content.style.display = 'none';
    }
  }

  function toggleMobileSubdropdown(event) {
    event.preventDefault();
    const toggle = event.currentTarget;
    const content = toggle.nextElementSibling;
    toggle.classList.toggle('active');
    if (content.style.display === 'none' || content.style.display === '') {
      content.style.display = 'block';
    } else {
      content.style.display = 'none';
    }
  }
</script>

{% schema %}
{
  "name": "Header Custom",
  "settings": [
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text/Icon Color", "default": "#717568" },
    { "type": "color", "id": "logo_color", "label": "Logo Color", "default": "#000000" },
    { "type": "header", "content": "Layout" },
    { "type": "link_list", "id": "main_menu", "label": "Select Menu" },
    { "type": "image_picker", "id": "logo_image", "label": "Logo Image" },
    {
      "type": "select",
      "id": "logo_position",
      "label": "Logo Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    { "type": "header", "content": "Icons" },
    { "type": "checkbox", "id": "show_search", "label": "Show Search Icon", "default": true },
    { "type": "checkbox", "id": "show_account", "label": "Show Account Icon", "default": true },
    { "type": "checkbox", "id": "show_cart", "label": "Show Cart Icon", "default": true }
  ],
  "presets": [{ "name": "Header Custom" }]
}
{% endschema %}
