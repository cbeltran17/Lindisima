<header class="site-header">
  <div class="header-container">
    <div class="header-left">
      <div class="logo">
          {% if section.settings.logo_image != blank %}
            <img src="{{ section.settings.logo_image | img_url: 'medium' }}" alt="{{ shop.name }}">
          {% else %}
            {{ shop.name }}
          {% endif %}
      </div>
    </div>
    <div class="header-center">
      <div class="mobile-menu-trigger" onclick="toggleMobileMenu()">
        <span></span>
        <span></span>
        <span></span>
      </div>
      
      <nav class="navigation desktop-only">
        {% for link in linklists[section.settings.main_menu].links %}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {% endfor %}
      </nav>
    </div>
    <div class="header-left header-left-mobile" style='display : none;'>
      <div class="mobile-menu-trigger" onclick="toggleMobileMenu()">
        <span></span>
        <span></span>
        <span></span>
      </div>
      
      <nav class="navigation desktop-only">
        {% for link in linklists[section.settings.main_menu].links %}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {% endfor %}
      </nav>
    </div>
    <div class="header-center header-center-mobile" style='display : none;'>
      <div class="logo">
          {% if section.settings.logo_image != blank %}
            <img src="{{ section.settings.logo_image | img_url: 'medium' }}" alt="{{ shop.name }}">
          {% else %}
            {{ shop.name }}
          {% endif %}
      </div>
    </div>
    <div class="header-right">
      {% if section.settings.show_search %}
        <a href="/search" class="icon-link">
          <img src="https://cdn.shopify.com/s/files/1/0790/8232/4206/files/Vector.png?v=1773398481" alt="Search" class="custom-icon">
        </a>
      {% endif %}
      
      {% if section.settings.show_account %}
        <a href="/account" class="icon-account desktop-only" style="display: flex; width: 20px;">
          <img src="https://cdn.shopify.com/s/files/1/0790/8232/4206/files/Group.png?v=1773398480" alt="Account" class="custom-icon">
        </a>
      {% endif %}

      {% if section.settings.show_cart %}
        <a href="/cart" class="icon-cart">
          <img src="https://cdn.shopify.com/s/files/1/0790/8232/4206/files/Group_1.png?v=1773398481" alt="Cart" class="custom-icon">
        </a>
      {% endif %}
    </div>
  </div>
</header>

<div id="mobile-sidebar" class="mobile-sidebar">
  <div class="sidebar-header">
    <div class="close-icon" onclick="toggleMobileMenu()">&times;</div>
  </div>
  <nav class="sidebar-navigation">
    {% for link in linklists[section.settings.main_menu].links %}
      <a href="{{ link.url }}">{{ link.title }}</a>
    {% endfor %}
  </nav>
</div>
<div id="sidebar-overlay" class="sidebar-overlay" onclick="toggleMobileMenu()"></div>
<style>
  .site-header {
    background-color: {{ section.settings.bg_color }};
    width: 100%;
        padding: 9px 0 11px 0;
    transition: background 0.3s ease;
  }
  .icon-cart{
    display: flex;
  }
  .header-container {
    max-width: 1820px;
    margin: 0 auto;
    padding: 0 10px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .header-left, .header-center, .header-right {
    flex: 1;
    display: flex;
    align-items: center;
  }
  .header-left .logo{
    width: 309px;
  }
.header-left .logo img{
  width: 100%;
}
  .header-center { justify-content: center; }
  .header-right { justify-content: flex-end; gap: 24px; }

  .navigation a {
    color: {{ section.settings.text_color }};
    font-family: 'Roboto', sans-serif !important;
    font-weight: 700;
    font-size: 24px;
    line-height: 100%;
    letter-spacing: 3%;
    text-decoration: none;
    margin-right: 35px;
  }

  .logo a {
    font-size: 34px;
    font-weight: 800;
    color: {{ section.settings.logo_color }};
    text-decoration: none;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .icon-link {
    display: flex;
    align-items: center;
    color: {{ section.settings.text_color }};
  }

  /* This ensures the custom SVG icon inherits the text color if it's coded with 'currentColor' */
  .icon-link svg {
    stroke: {{ section.settings.text_color }};
  }
  /* Sidebar Styles */
.mobile-sidebar {
  position: fixed;
  top: 0;
  left: -100%; /* Hidden by default */
  width: 300px;
  height: 100%;
  background: #fff;
  z-index: 1000;
  transition: 0.3s ease;
  padding: 20px;
  box-shadow: 2px 0 10px rgba(0,0,0,0.1);
}
img.custom-icon{
  width: 23px;
}
.mobile-sidebar.active {
  left: 0;
}

.sidebar-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.5);
  display: none;
  z-index: 999;
}

.sidebar-overlay.active {
  display: block;
}

.sidebar-header {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 30px;
}

.close-icon {
  font-size: 35px;
  cursor: pointer;
  color: {{ section.settings.text_color }};
}

.sidebar-navigation a {
  display: block;
  padding: 15px 0;
  font-size: 18px;
  text-decoration: none;
  color: {{ section.settings.text_color }};
  border-bottom: 1px solid #eee;
}

/* Hamburger Icon */
.mobile-menu-trigger {
  display: none; /* Hidden on desktop */
  flex-direction: column;
  gap: 5px;
  cursor: pointer;
}

.mobile-menu-trigger span {
  width: 25px;
  height: 2px;
  background-color: {{ section.settings.text_color }};
}

/* Desktop vs Mobile logic */
@media (max-width: 768px) {
  .header-left{
    display: none !important;
  }
  .header-center{
    display: none !important;
  }
  .header-center.header-center-mobile {
    display: block !important;
  }
  .header-left.header-left-mobile {
    display: block !important;
  }

  .site-header{
    padding: 12px 0;
  }
  .desktop-only {
    display: none !important;
  }
  
  .mobile-menu-trigger {
    display: flex;
  }

  .header-left, .header-right {
    flex: 1;
  }

  .logo img {
    max-width: 150px; /* Adjust based on your logo */
  }
}

@media (min-width: 769px) {
  .mobile-menu-trigger {
    display: none;
  }
}
</style>
<script>
  function toggleMobileMenu() {
    const sidebar = document.getElementById('mobile-sidebar');
    const overlay = document.getElementById('sidebar-overlay');
    
    sidebar.classList.toggle('active');
    overlay.classList.toggle('active');
    
    // Prevent scrolling when menu is open
    if (sidebar.classList.contains('active')) {
      document.body.style.overflow = 'hidden';
    } else {
      document.body.style.overflow = '';
    }
  }
</script>
{% schema %}
{
  "name": "Header Custom",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text/Icon Color",
      "default": "#717568"
    },
    {
      "type": "color",
      "id": "logo_color",
      "label": "Logo Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "link_list",
      "id": "main_menu",
      "label": "Select Menu"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo Image"
    },
    {
      "type": "select",
      "id": "logo_position",
      "label": "Logo Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Icons"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show Search Icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show Account Icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show Cart Icon",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Header Custom"
    }
  ]
}
{% endschema %}