<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">

<style>
  .ws {
    --ws-cream: #FAF5EE;
    --ws-cream-dark: #F0E7D8;
    --ws-ink: #2E2A24;
    --ws-green: #3F4B3B;
    --ws-terracotta: #C17A54;
    --ws-blush: #E7C9BC;
    --ws-line: #E3D9C8;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px 100px;
    color: var(--ws-ink);
    font-family: 'Jost', sans-serif;
    font-weight: 300;
  }

  .ws h1, .ws h2, .ws h3 {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 600;
    color: var(--ws-green);
    letter-spacing: 0.02em;
  }

  .ws-hero {
    text-align: center;
    padding: 90px 0 60px;
    border-bottom: 1px solid var(--ws-line);
    margin-bottom: 64px;
  }
  .ws-hero .ws-eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.25em;
    font-size: 12px;
    color: var(--ws-terracotta);
    margin-bottom: 18px;
    display: block;
  }
  .ws-hero h1 {
    font-size: clamp(38px, 5vw, 58px);
    line-height: 1.1;
    margin: 0 0 22px;
  }
  .ws-hero p {
    max-width: 560px;
    margin: 0 auto;
    font-size: 17px;
    line-height: 1.7;
    color: #5C574E;
  }

  .ws-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin-bottom: 90px;
  }
  .ws-step {
    text-align: center;
    padding: 8px 12px;
  }
  .ws-step-num {
    width: 40px;
    height: 40px;
    line-height: 40px;
    border-radius: 50%;
    background: var(--ws-cream-dark);
    color: var(--ws-green);
    font-family: 'Cormorant Garamond', serif;
    font-size: 18px;
    font-weight: 600;
    margin: 0 auto 16px;
  }
  .ws-step h3 {
    font-size: 20px;
    margin: 0 0 8px;
  }
  .ws-step p {
    font-size: 14.5px;
    line-height: 1.6;
    color: #6B6659;
    margin: 0;
  }

  .ws-form-section {
    background: var(--ws-cream);
    border-radius: 18px;
    padding: 56px clamp(24px, 6vw, 72px);
  }
  .ws-form-section .ws-form-head {
    text-align: center;
    margin-bottom: 44px;
  }
  .ws-form-section h2 {
    font-size: 34px;
    margin: 0 0 10px;
  }
  .ws-form-section .ws-form-head p {
    color: #6B6659;
    font-size: 15px;
  }

  .ws-form-success {
    background: #EEF1E8;
    border: 1px solid #C9D3B9;
    color: var(--ws-green);
    padding: 16px 20px;
    border-radius: 10px;
    margin-bottom: 28px;
    font-size: 15px;
  }
  .ws-form-error {
    background: #F7E9E4;
    border: 1px solid var(--ws-blush);
    color: #8A4A34;
    padding: 16px 20px;
    border-radius: 10px;
    margin-bottom: 28px;
    font-size: 15px;
  }

  .ws-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px 28px;
  }
  .ws-field { display: flex; flex-direction: column; }
  .ws-field.full { grid-column: 1 / -1; }

  .ws label {
    font-size: 12.5px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ws-green);
    margin-bottom: 8px;
  }
  .ws label .req { color: var(--ws-terracotta); }

  .ws input[type="text"],
  .ws input[type="email"],
  .ws input[type="tel"],
  .ws select,
  .ws textarea {
    font-family: 'Jost', sans-serif;
    font-weight: 400;
    font-size: 15px;
    color: var(--ws-ink);
    background: #fff;
    border: 1px solid var(--ws-line);
    border-radius: 8px;
    padding: 13px 15px;
    outline: none;
    transition: border-color 0.15s ease;
    width: 100%;
    box-sizing: border-box;
  }
  .ws input:focus,
  .ws select:focus,
  .ws textarea:focus {
    border-color: var(--ws-terracotta);
  }
  .ws textarea { resize: vertical; min-height: 90px; }

  .ws-submit-row {
    margin-top: 36px;
    text-align: center;
  }
  .ws button[type="submit"] {
    font-family: 'Jost', sans-serif;
    font-size: 13px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    background: var(--ws-green);
    color: #fff;
    border: none;
    border-radius: 30px;
    padding: 16px 48px;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .ws button[type="submit"]:hover {
    background: #2E3629;
  }

  @media (max-width: 720px) {
    .ws-steps { grid-template-columns: 1fr; gap: 40px; }
    .ws-grid { grid-template-columns: 1fr; }
    .ws-hero { padding: 60px 0 40px; }
    .ws-form-section { padding: 40px 22px; border-radius: 12px; }
  }
</style>

<div class="ws">

  <div class="ws-hero">
    <span class="ws-eyebrow">{{ section.settings.eyebrow }}</span>
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.intro }}</p>
  </div>

  <div class="ws-steps">
    <div class="ws-step">
      <div class="ws-step-num">1</div>
      <h3>Apply</h3>
      <p>Tell us about your business below — it takes about two minutes.</p>
    </div>
    <div class="ws-step">
      <div class="ws-step-num">2</div>
      <h3>We review</h3>
      <p>Our team reviews every application personally, usually within 3–5 business days.</p>
    </div>
    <div class="ws-step">
      <div class="ws-step-num">3</div>
      <h3>Get access</h3>
      <p>Once approved, you'll receive wholesale pricing and next steps for your first order.</p>
    </div>
  </div>

  <div class="ws-form-section">
    <div class="ws-form-head">
      <h2>Wholesale Application</h2>
      <p>Fields marked with an asterisk are required.</p>
    </div>

    {% form 'contact' %}
      {% if form.posted_successfully? %}
        <div class="ws-form-success">
          Thank you — your application has been received. Our team will be in touch within 3–5 business days.
        </div>
      {% endif %}

      {% if form.errors %}
        <div class="ws-form-error">Please fill in all required fields and try again.</div>
      {% endif %}

      <input type="hidden" name="contact[subject]" value="New Wholesale Application">
      <input type="hidden" name="contact[tags]" value="wholesale-application">

      <div class="ws-grid">
        <div class="ws-field">
          <label for="ContactFormBusinessName">Business / Store Name <span class="req">*</span></label>
          <input type="text" id="ContactFormBusinessName" name="contact[Business Name]" required>
        </div>

        <div class="ws-field">
          <label for="ContactFormContactName">Contact Name &amp; Title <span class="req">*</span></label>
          <input type="text" id="ContactFormContactName" name="contact[Contact Name]" required>
        </div>

        <div class="ws-field">
          <label for="ContactFormEmail">Email <span class="req">*</span></label>
          <input type="email" id="ContactFormEmail" name="contact[email]" value="{{ form.email }}" required>
        </div>

        <div class="ws-field">
          <label for="ContactFormPhone">Phone</label>
          <input type="tel" id="ContactFormPhone" name="contact[Phone]">
        </div>

        <div class="ws-field">
          <label for="ContactFormWebsite">Website</label>
          <input type="text" id="ContactFormWebsite" name="contact[Website]">
        </div>

        <div class="ws-field">
          <label for="ContactFormSocial">Social Media Handles</label>
          <input type="text" id="ContactFormSocial" name="contact[Social Media]" placeholder="Instagram, TikTok, etc.">
        </div>

        <div class="ws-field">
          <label for="ContactFormBusinessType">Business Type <span class="req">*</span></label>
          <select id="ContactFormBusinessType" name="contact[Business Type]" required>
            <option value="">Select one</option>
            <option value="Boutique">Boutique</option>
            <option value="Spa">Spa</option>
            <option value="Salon">Salon</option>
            <option value="Online Retailer">Online Retailer</option>
            <option value="Other">Other</option>
          </select>
        </div>

        <div class="ws-field">
          <label for="ContactFormTaxId">Resale / Tax ID Number <span class="req">*</span></label>
          <input type="text" id="ContactFormTaxId" name="contact[Resale Tax ID]" required>
        </div>

        <div class="ws-field full">
          <label for="ContactFormVolume">Estimated Monthly Order Volume <span class="req">*</span></label>
          <select id="ContactFormVolume" name="contact[Estimated Volume]" required>
            <option value="">Select a range</option>
            <option value="Under $500">Under $500</option>
            <option value="$500–$1,500">$500–$1,500</option>
            <option value="$1,500–$5,000">$1,500–$5,000</option>
            <option value="$5,000+">$5,000+</option>
          </select>
        </div>

        <div class="ws-field full">
          <label for="ContactFormMessage">Anything else we should know?</label>
          <textarea id="ContactFormMessage" name="contact[body]" rows="4"></textarea>
        </div>
      </div>

      <div class="ws-submit-row">
        <button type="submit">Submit Application</button>
      </div>
    {% endform %}
  </div>

</div>

{% schema %}
{
  "name": "Wholesale Application",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Wholesale & Stockists"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Partner with LINDÍSIMA"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro paragraph",
      "default": "We work with a small, curated group of boutiques, spas, salons, and online retailers who care about clean, intentional beauty as much as we do. If that sounds like you, we'd love to hear from you."
    }
  ],
  "presets": [
    {
      "name": "Wholesale Application"
    }
  ]
}
{% endschema %}
