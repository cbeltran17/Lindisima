{% comment %} 
  Modular Footer - Mobile Optimized Stacking
  Matches uploaded reference: image_ca54fa.png
{% endcomment %}

<style>
  .footer-wrapper-{{ section.id }} {
    background-color: {{ section.settings.footer_bg_color }};
    padding: 103px 0 15px 0;
    width: 100%;
    color: #000;
  }

  .footer-container {
    max-width: 1820px;
    margin: 0 auto;
    padding: 0 17px;
  }

  /* Tier 1: Email Signup */
  .footer-tier-top {
    text-align: center;
    margin-bottom: 71px;
  }
  .newsletter-title {
   margin-bottom: 12px;
    margin-top: 0;
    font-weight: 700;
    font-size: 34px;
    line-height: 100%;
    letter-spacing: 2%;
    text-transform: none;
  }
  .newsletter-sub {
        margin-bottom: 25px;
    font-weight: 400;
    font-size: 25px;
    line-height: 24px;
    letter-spacing: 0%;
    text-align: center;
    margin-top: 0;
  }
  .footer-email-form {
    max-width: 523px;
    margin: 0 auto;
    position: relative;
    background: #fff; /* Matches white input box in mobile ref */
    padding: 5px 15px;
  }
  .footer-email-form input {
       width: 100%;
    background: transparent;
    border: none;
    padding: 12px 0;
    color: #A7B2A2;
    outline: none;
    font-weight: 400;
    font-size: 16px;
    line-height: 24px;
    letter-spacing: 0%;
  }
  .footer-email-form .submit-arrow {
    position: absolute;
    right: 15px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    cursor: pointer;
    color: #ccc;
  }

  /* Tier 2: Logo and Menus */
  .footer-tier-middle {
    padding-bottom: 105px;
    display: grid;
    grid-template-columns: 583px 1fr;
  }
  
  .footer-brand-side {
    text-align: left;
    margin-bottom: 0;
  }
  .footer-logo img {
    max-width: 300px;
    height: auto;
  }

  .footer-menu-side {
    flex: 1;
    display: flex;
    justify-content: space-between;
    width: 100%;
  }

  .footer-column {
    flex: 1;
  }

  .footer-column h3 {
   margin-bottom: 20px;
    text-transform: none;
    font-weight: 400;
    font-size: 25px;
    line-height: 24px;
    letter-spacing: 0%;
    margin-top: 0;
  }
  .footer-column ul li:last-child {
    margin-bottom: 0;
}
  .footer-column ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .footer-column ul li {
    margin-bottom: 16px;
  }
  .footer-column ul li a {
       text-decoration: none;
    color: inherit;
    font-weight: 400;
    font-size: 16px;
    line-height: 24px;
    letter-spacing: 0%;
  }

  /* Tier 3: Bottom Bar */
  .footer-tier-bottom {
    border-top: 1px solid rgba(0, 0, 0, 0.1);
    padding: 16px 0;
    text-align: center;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .payment-icons { 
    display: flex; 
    gap: 10px; 
    justify-content: center;
    margin-bottom: 0;
  }
  .payment-icons svg, .payment-icons img { 
    height: 22px; 
    width: auto;
  }

  .copyright-text { 
    font-weight: 400;
    font-size: 16px;
    line-height: 24px;
    letter-spacing: 0%;
    text-transform: uppercase;
  }
#contact_form{
    margin: 0;
}
  /* Specific Mobile Overrides to match image_ca54fa.png */
  @media (max-width: 767px) {
      .footer-tier-top {
        margin-bottom: 34px;
      }
    .footer-wrapper-{{ section.id }} {
        padding: 44px 0 15px 0;
    }
    .footer-email-form{
        padding: 0 15px;
    }
    .footer-menu-side {
      flex-direction: column;
      gap: 33px;
    }
    .footer-column {
      display: flex;
        justify-content: center; /* Image shows left aligned links on mobile */
    }
    .footer-menu-side .footer-column {
        flex-direction: column !important;
    }
    .footer-column h3{
            font-weight: 500;   
    }
    .footer-column ul li a{
            font-size: 20px;
    }
    .footer-logo {
        display: flex;
        justify-content: center;
    }
    .newsletter-title {
        font-size: 26px;
    }
    .newsletter-sub{
        font-size: 20px;
    }
    .footer-tier-middle{
        grid-template-columns: 1fr;
    }
    .footer-tier-bottom{
            flex-direction: column-reverse;
    gap: 17px;
    padding: 29px 0 16px 0;
    }
    .footer-tier-middle{
        padding-bottom: 43px;
    }
  }
</style>

<footer class="footer-wrapper-{{ section.id }}">
  <div class="footer-container">
    
    <div class="footer-tier-top">
      {% for block in section.blocks %}
        {% if block.type == 'newsletter' %}
          <div class="newsletter-block" {{ block.shopify_attributes }}>
            <h2 class="newsletter-title">{{ block.settings.heading }}</h2>
            <p class="newsletter-sub">{{ block.settings.subheading }}</p>
            <div class="footer-email-form">
              {% form 'customer' %}
                <input type="email" name="contact[email]" placeholder="Your Email Address" required>
                <button type="submit" class="submit-arrow">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </button>
              {% endform %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="footer-tier-middle">
      <div class="footer-brand-side">
        <div class="footer-logo">
          {% if section.settings.logo != blank %}
            <img src="{{ section.settings.logo | img_url: '400x' }}" alt="{{ shop.name }}">
          {% else %}
            <h2 style="margin:0; font-size: 28px; letter-spacing: 2px;">LINDÍSIMA.</h2>
          {% endif %}
        </div>
      </div>

      <div class="footer-menu-side">
        {% for block in section.blocks %}
          {% if block.type == 'link_list' %}
            <div class="footer-column" {{ block.shopify_attributes }}>
              <h3>{{ block.settings.heading }}</h3>
              <ul>
                {% for link in block.settings.menu.links %}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="footer-tier-bottom">
        <div class="copyright-text">
            COPYRIGHT © {{ 'now' | date: "%Y" }} {{ shop.name | upcase }} ALL RIGHTS RESERVED.
        </div>
        <div class="payment-icons">
            {% if section.settings.show_payment_icons %}
                <img src="https://cdn.shopify.com/s/files/1/0790/8232/4206/files/Group_12.svg?v=1773387160"  alt="Visa">
            {% endif %}
        </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Updated Footer",
  "settings": [
    {
      "type": "color",
      "id": "footer_bg_color",
      "label": "Background Color",
      "default": "#9BA695"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer Logo"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show Payment Icons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "newsletter",
      "name": "Email Signup",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Sign up for updates and get 10% discount" },
        { "type": "text", "id": "subheading", "label": "Subheading", "default": "By signing up you agree to our terms." }
      ]
    },
    {
      "type": "link_list",
      "name": "Footer Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Menu Heading", "default": "Quick Links" },
        { "type": "link_list", "id": "menu", "label": "Select Menu" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Mobile Footer",
      "blocks": [
        { "type": "newsletter" },
        { "type": "link_list", "settings": { "heading": "Quick Links" } },
        { "type": "link_list", "settings": { "heading": "Our Company" } },
        { "type": "link_list", "settings": { "heading": "Our Policies" } }
      ]
    }
  ]
}
{% endschema %}