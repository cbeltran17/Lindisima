<script
  type="application/json"
  data-section-id="{{ section.id }}"
  data-section-type="static-collection"
></script>

{% liquid
  assign products_per_page = section.settings.products_per_row | times: section.settings.number_of_rows

  assign use_masonry = false
  if section.settings.layout == 'masonry'
    assign use_masonry = true
  endif

  assign show_filters = false
  if section.settings.show_filters
    assign show_filters = true
  endif

  assign show_sorting = false
  if section.settings.sorting
    assign show_sorting = true
  endif

  assign show_collection_image = false
  if collection.image and section.settings.show_collection_image
    assign show_collection_image = true
  endif
%}

<style>
  /* AJUSTEMENT DES ESPACES */
  .page-title { margin-top: 10px !important; margin-bottom: 10px !important; }
  .collection-header { margin-top: 0 !important; padding-top: 0 !important; margin-bottom: 0 !important; }
  .collection { margin-top: 0 !important; padding-top: 0 !important; }
  .main-content, .shopify-section { padding-top: 0 !important; margin-top: 0 !important; }
  .collection-filters { margin-top: 10px !important; }

  /* PRODUCT CARDS */
  .collection-products {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
  }

  .collection-product-card {
    width: 33.33%;
    box-sizing: border-box;
    padding: 0 12px 24px;
  }

  .collection-product-card__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .collection-product-card__image-wrapper {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 12px;
    overflow: hidden;
    background: #f5f5f5;
  }

  .collection-product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 12px;
    background: #f5f5f5;
    transition: transform 0.5s ease;
  }

  .collection-product-card:hover .collection-product-card__image {
    transform: scale(1.05);
  }

  /* Out of Stock Label */
  .out-of-stock-label {
    position: absolute;
    top: 8px;
    left: 8px;
    background-color: #000000;
    color: #fff;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 4px 8px;
    border-radius: 4px;
    z-index: 20;
    line-height: 1;
    text-decoration: none;
  }

  .collection-product-card__info {
    margin-top: 14px;
    text-align: left;
  }

  .collection-product-card__badges {
    margin-bottom: 12px;
  }

  .collection-product-card__badges.is-single {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .collection-product-card__badges.is-double {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .collection-product-card__badges.is-multi {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .collection-product-card__badges.is-double .collection-product-card__badge {
    width: 100%;
  }

  .collection-product-card__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #7f9474;
    color: #FFFFFF;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 8px 18px;
    border-radius: 6px;
    line-height: 1;
    white-space: nowrap;
    font-family: inherit;
    border: none;
    cursor: default;
    user-select: none;
    box-sizing: border-box;
    min-width: 0;
  }

  .collection-product-card__title {
    font-size: 16px;
    font-weight: 700;
    margin: 0 0 5px 0;
    color: #000;
    text-decoration: none;
    display: block;
  }

  .collection-product-card__price {
    font-size: 16px;
    font-weight: 400;
    color: #000;
  }

  /* MOBILE */
  @media screen and (max-width: 768px) {
    .page-title { margin: 5px 0 !important; font-size: 1.2rem !important; text-align: center; }
    .breadcrumb { display: none !important; }

    .collection-header {
      margin-top: 0 !important;
      margin-bottom: 5px !important;
      padding: 0 !important;
    }

    .collection-filters {
      display: flex !important;
      flex-direction: row !important;
      flex-wrap: nowrap !important;
      overflow-x: auto !important;
      padding: 5px 10px !important;
      gap: 8px !important;
      align-items: center !important;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .collection-filters::-webkit-scrollbar { display: none; }

    .collection-filters__title,
    .collection-filters label,
    .faceted-filters .collection-filters__title {
      display: none !important;
    }

    .faceted-filters, .collection-sorting__wrapper {
      margin: 0 !important;
      flex: 0 0 auto !important;
    }

    .collection-dropdown .select,
    .faceted-filters [data-filter-item],
    .collection-dropdown.select-wrapper {
      padding: 4px 20px 4px 8px !important;
      font-size: 11px !important;
      height: 28px !important;
      min-width: 80px !important;
      border-radius: 4px !important;
      background-position: right 5px center !important;
    }

    .collection-products {
      margin-top: 5px !important;
    }

    .collection-product-card {
      width: 50% !important;
      padding: 0 6px 14px;
    }

    .collection-product-card__image-wrapper {
      border-radius: 10px;
    }

    .collection-product-card__image {
      border-radius: 10px;
    }

    .out-of-stock-label {
      font-size: 8px;
      padding: 3px 6px;
      top: 6px;
      left: 6px;
      border-radius: 3px;
    }

    .collection-product-card__info {
      margin-top: 10px;
    }

    .collection-product-card__badges {
      margin-bottom: 10px;
    }

    .collection-product-card__badges.is-single { gap: 8px; }
    .collection-product-card__badges.is-double { gap: 8px; }
    .collection-product-card__badges.is-multi  { gap: 8px; }

    .collection-product-card__badge {
      font-size: 10px;
      padding: 7px 12px;
      letter-spacing: 0.10em;
    }

    .collection-product-card__title { font-size: 14px; }
    .collection-product-card__price { font-size: 14px; }
  }

  /* PAGINATION */
  .dot-pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    padding: 20px 0 10px;
    list-style: none;
    margin: 0;
  }

  .dot-pagination__item { display: inline-flex; }

  .dot-pagination__dot {
    display: block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: #cccccc;
    border: 2px solid transparent;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.2s ease, border-color 0.3s ease;
    text-decoration: none;
    outline: none;
  }

  .dot-pagination__dot:hover {
    background-color: #888888;
    transform: scale(1.25);
  }

  .dot-pagination__dot--active {
    background-color: #1a1a1a;
    border-color: #1a1a1a;
    transform: scale(1.35);
    cursor: default;
    pointer-events: none;
  }

  .dot-pagination__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background-color: transparent;
    border: 1.5px solid #cccccc;
    color: #555555;
    font-size: 14px;
    text-decoration: none;
    transition: background-color 0.3s ease, border-color 0.3s ease, color 0.3s ease;
    line-height: 1;
  }

  .dot-pagination__arrow:hover {
    background-color: #1a1a1a;
    border-color: #1a1a1a;
    color: #ffffff;
  }

  .dot-pagination__arrow--disabled {
    opacity: 0.3;
    pointer-events: none;
    cursor: default;
  }
</style>

<style>
  #collection-{{ section.id }} .collection-product-card {
    width: calc(100% / {{ section.settings.products_per_row }});
  }
</style>

<div>
  {% unless use_masonry %}
    <h1 class="page-title">{{ collection.title }}</h1>
    {% render 'breadcrumbs' %}
  {% endunless %}

  {% paginate collection.products by products_per_page %}

  <section
    class="collection collection-image--{{ show_collection_image }}"
    data-product-hover="{{ settings.product_hover }}"
    {% if use_masonry %}data-collection-masonry{% endif %}
    data-section-id="{{ section.id }}"
    data-section-type="collection"
  >

    {% if use_masonry or show_collection_image or collection.description != blank or show_sorting or show_filters %}
      <div
        class="
          collection-header
          {% if use_masonry %} collection-header-alternate {% endif %}
          {% if show_filters and show_sorting %} collection-header--filters-sort-enabled {% endif %}
        "
      >

        {% if show_collection_image %}
          <div class="collection-featured-image">
            {% render 'rimg',
              img: collection.image,
              size: '1024x1024',
              lazy: true
            %}
          </div>
        {% endif %}

        <div class="collection-header-content">

          {% if use_masonry %}
            {% render 'breadcrumbs' %}
            <h1 class="page-title">{{ collection.title }}</h1>
          {% endif %}

          {% if collection.description != blank and section.settings.show_description %}
            <div class="collection-description rte">
              {{ collection.description }}
            </div>
          {% endif %}

          {% if show_filters or show_sorting %}
            <div class="collection-filters">

              {% if show_filters and collection.filters.size > 0 %}
                <div class="faceted-filters" data-faceted-filter>
                  {% render "faceted-filters",
                    filters: collection.filters,
                    class_prefix: 'collection'
                  %}
                </div>
              {% endif %}

              {% if show_sorting %}
                <div class="collection-sorting__wrapper">
                  <div class="collection-dropdown select-wrapper">
                    <label class="collection-filters__title" for="collection-sorting">
                      {{ 'collections.collection.sort_by' | t }}
                    </label>
                    <select
                      class="select"
                      id="collection-sorting"
                      data-collection-sorting
                    >
                      {% for option in collection.sort_options %}
                        <option
                          value="{{ option.value }}"
                          {% if option.value == collection.sort_by %}selected{% endif %}
                        >
                          {{ option.name }}
                        </option>
                      {% endfor %}
                    </select>
                  </div>
                </div>
              {% endif %}

            </div>
          {% endif %}

        </div>
      </div>
    {% endif %}

    <div
      class="
        collection-products
        {% if use_masonry %} collection-products-masonry {% endif %}
      "
      {% if use_masonry %}data-collection-masonry-grid{% endif %}
      id="collection-{{ section.id }}"
    >

      {% if collection.products.size == 0 %}

        <div class="collection-empty">
          <p>{{ 'collections.collection.no_products' | t }}</p>
        </div>

      {% else %}

        {% if collection.handle == 'all' and collection.all_vendors.size == 0 and collection.all_types.size == 0 %}

          {% for i in (1..section.settings.products_per_row) %}
            {% capture productImage %}
              {% cycle 'product-1', 'product-2', 'product-3' %}
            {% endcapture %}
            {% assign image = productImage | placeholder_svg_tag: 'placeholder-svg' %}

            <div class="collection-product-card">
              <div class="collection-product-card__link">
                <div class="collection-product-card__image-wrapper">
                  {{ image }}
                </div>
                <div class="collection-product-card__info">
                  <div class="collection-product-card__badges is-single">
                    <span class="collection-product-card__badge">Badge</span>
                  </div>
                  <a href="#" class="collection-product-card__title">Product name here</a>
                  <span class="collection-product-card__price">$25.00</span>
                </div>
              </div>
            </div>
          {% endfor %}

        {% else %}

          {% for product in collection.products %}
            <div class="collection-product-card">
              <div class="collection-product-card__image-wrapper">
                {% unless product.available %}
                  <a href="https://lindisimany.com/pages/notify-me" class="out-of-stock-label">NOTIFY ME</a>
                {% endunless %}
                <a href="{{ product.url }}" style="display: block; width: 100%; height: 100%;">
                  {% if product.featured_image != blank %}
                    <img
                      class="collection-product-card__image"
                      src="{{ product.featured_image | img_url: '600x600', crop: 'center' }}"
                      alt="{{ product.title | escape }}"
                      loading="lazy"
                    >
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {% endif %}
                </a>
              </div>

              <div class="collection-product-card__info">
                {% if product.metafields.custom.badges != blank and product.metafields.custom.badges.value != blank %}
                  {% assign badge_count = product.metafields.custom.badges.value.size %}
                  <div class="collection-product-card__badges {% if badge_count == 1 %}is-single{% elsif badge_count == 2 %}is-double{% else %}is-multi{% endif %}">
                    {% for badge in product.metafields.custom.badges.value %}
                      <span class="collection-product-card__badge">{{ badge }}</span>
                    {% endfor %}
                  </div>
                {% endif %}

                <a href="{{ product.url }}" class="collection-product-card__title">{{ product.title }}</a>
                <span class="collection-product-card__price">{{ product.price | money }}</span>
              </div>
            </div>
          {% endfor %}

        {% endif %}

      {% endif %}

    </div>

  </section>

  {% if paginate.pages > 1 %}
    <nav aria-label="Pagination" class="dot-pagination-wrapper">
      <ul class="dot-pagination">

        <li class="dot-pagination__item">
          {% if paginate.previous %}
            <a href="{{ paginate.previous.url }}" class="dot-pagination__arrow" aria-label="Page précédente">&#8249;</a>
          {% else %}
            <span class="dot-pagination__arrow dot-pagination__arrow--disabled" aria-hidden="true">&#8249;</span>
          {% endif %}
        </li>

        {% for part in paginate.parts %}
          <li class="dot-pagination__item">
            {% if part.is_link %}
              <a href="{{ part.url }}" class="dot-pagination__dot" aria-label="Page {{ part.title }}" title="Page {{ part.title }}"></a>
            {% else %}
              {% if part.title == paginate.current_page %}
                <span class="dot-pagination__dot dot-pagination__dot--active" aria-current="page" aria-label="Page {{ part.title }} (actuelle)" title="Page {{ part.title }}"></span>
              {% else %}
                <span class="dot-pagination__dot dot-pagination__arrow--disabled" aria-hidden="true" title="…"></span>
              {% endif %}
            {% endif %}
          </li>
        {% endfor %}

        <li class="dot-pagination__item">
          {% if paginate.next %}
            <a href="{{ paginate.next.url }}" class="dot-pagination__arrow" aria-label="Page suivante">&#8250;</a>
          {% else %}
            <span class="dot-pagination__arrow dot-pagination__arrow--disabled" aria-hidden="true">&#8250;</span>
          {% endif %}
        </li>

      </ul>
    </nav>
  {% endif %}

  {% endpaginate %}
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var dots = document.querySelectorAll('.dot-pagination__dot:not(.dot-pagination__dot--active)');
    dots.forEach(function (dot) {
      dot.addEventListener('click', function () {
        document.querySelectorAll('.dot-pagination__dot').forEach(function (d) {
          d.classList.remove('dot-pagination__dot--active');
        });
        dot.classList.add('dot-pagination__dot--active');
      });
    });
  });
</script>

{% schema %}
{
  "name": "Collection pages",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "label": "Show collection image"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show description"
    },
    {
      "type": "checkbox",
      "id": "sorting",
      "label": "Enable sorting",
      "info": "Parameters include: best selling, A-Z, newest to oldest, etc."
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Enable filtering",
      "default": true
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "masonry", "label": "Masonry" }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "products_per_row",
      "label": "Products per row",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "number_of_rows",
      "label": "Rows",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 3
    }
  ]
}
{% endschema %}
