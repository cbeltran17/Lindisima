    "faq_section_URWjb8": {
      "type": "faq_section",
      "blocks": {
        "faq_item_e8NkfX": {
          "type": "faq_item",
          "settings": {
            "question": "What is LINDÍSIMA’s mission?",
            "answer": "<p>Our mission is to create conscious beauty products rooted in intention, purity, and care. We believe beauty should feel honest, accessible, and deeply connected to well-being — honoring both skin and self through clean, cruelty-free formulations. Every product is designed to support mindful rituals and encourage a more intentional way of caring for yourself.</p>"
          }
        },
        "faq_item_449E9G": {
          "type": "faq_item",
          "settings": {
            "question": "What does “conscious beauty” mean to LINDÍSIMA?",
            "answer": "<p>To us, conscious beauty means creating products with intention, transparency, and care. Our formulations prioritize skin health, ingredient integrity, and mindful self-care rituals.</p>"
          }
        },
        "faq_item_7LQTMR": {
          "type": "faq_item",
          "settings": {
            "question": "Are LINDÍSIMA products cruelty-free?",
            "answer": "<p>Yes. All LINDÍSIMA products are cruelty-free. We never test on animals and work with partners who share the same commitment to ethical beauty.</p>"
          }
        },
        "faq_item_EqagyL": {
          "type": "faq_item",
          "settings": {
            "question": "Are all LINDÍSIMA products vegan?",
            "answer": "<p>Not all of our products are vegan. Each product listing clearly indicates whether or not it is vegan so you can choose products that align with your preferences.</p>"
          }
        },
        "faq_item_Xf9GgP": {
          "type": "faq_item",
          "settings": {
